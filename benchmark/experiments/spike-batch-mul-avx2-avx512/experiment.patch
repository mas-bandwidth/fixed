+typedef void ( *fixMulBatchFn )( fixed_t*, const fixed_t*, const fixed_t*, size_t );
+typedef void ( *fixDotBatchFn )( fixed_t*, const fixed_t*, const fixed_t*, const fixed_t*,
+	const fixed_t*, const fixed_t*, const fixed_t*, size_t );
+
+static void fixMulBatchScalar( fixed_t* out, const fixed_t* a, const fixed_t* b, size_t n )
+{
+	for ( size_t i = 0; i < n; ++i ) out[i] = fixMul( a[i], b[i] );
+}
+
+static void fixDotBatchScalar( fixed_t* out, const fixed_t* ax, const fixed_t* ay, const fixed_t* az,
+	const fixed_t* bx, const fixed_t* by, const fixed_t* bz, size_t n )
+{
+	for ( size_t i = 0; i < n; ++i )
+	{
+		fixVec3 a = { ax[i], ay[i], az[i] }, b = { bx[i], by[i], bz[i] };
+		out[i] = fixDot( a, b );
+	}
+}
+
+#if FIX_BATCH_X86
+	#define FIX_TARGET_AVX2 __attribute__((target("avx2")))
+	#define FIX_TARGET_AVX512 __attribute__((target("avx512f,avx512dq")))
+
+// A*B >> 16, modulo 2^64, is A*(B >> 16) + (A*(B & 0xffff) >> 16).
+// In the second term, split A into a signed high 32 and unsigned low 32.
+// The low 32 product plus the optional half-ulp fits in 48 bits; the signed
+// high 32 product shifted 16 is exact modulo 2^64. This also covers INT64_MIN.
+FIX_TARGET_AVX2 static __m256i fixMulShiftAVX2( __m256i a, __m256i b, uint64_t half )
+{
+	const __m256i mask = _mm256_set1_epi64x( 0xffff );
+	const __m256i z = _mm256_setzero_si256();
+	__m256i bShift = _mm256_or_si256( _mm256_srli_epi64( b, 16 ),
+		_mm256_slli_epi64( _mm256_cmpgt_epi64( z, b ), 48 ) );
+	__m256i lo = _mm256_mul_epu32( a, bShift );
+	__m256i cross = _mm256_add_epi64( _mm256_mul_epu32( _mm256_srli_epi64( a, 32 ), bShift ),
+		_mm256_mul_epu32( a, _mm256_srli_epi64( bShift, 32 ) ) );
+	__m256i first = _mm256_add_epi64( lo, _mm256_slli_epi64( cross, 32 ) );
+	__m256i blo = _mm256_and_si256( b, mask );
+	__m256i ahi = _mm256_srli_epi64( a, 32 );
+	__m256i high = _mm256_slli_epi64( _mm256_mul_epi32( ahi, blo ), 16 );
+	__m256i low = _mm256_srli_epi64( _mm256_add_epi64( _mm256_mul_epu32( a, blo ),
+		_mm256_set1_epi64x( (int64_t)half ) ), 16 );
+	return _mm256_add_epi64( first, _mm256_add_epi64( high, low ) );
+}
+
+FIX_TARGET_AVX512 static __m512i fixMulShiftAVX512( __m512i a, __m512i b, uint64_t half )
+{
+	const __m512i mask = _mm512_set1_epi64( 0xffff );
+	__m512i first = _mm512_mullo_epi64( a, _mm512_srai_epi64( b, 16 ) );
+	__m512i blo = _mm512_and_si512( b, mask );
+	__m512i high = _mm512_slli_epi64( _mm512_mul_epi32( _mm512_srli_epi64( a, 32 ), blo ), 16 );
+	__m512i low = _mm512_srli_epi64( _mm512_add_epi64( _mm512_mul_epu32( a, blo ),
+		_mm512_set1_epi64( (int64_t)half ) ), 16 );
+	return _mm512_add_epi64( first, _mm512_add_epi64( high, low ) );
+}
+
+FIX_TARGET_AVX2 static void fixMulBatchAVX2( fixed_t* out, const fixed_t* a, const fixed_t* b, size_t n )
+{
+	size_t i = 0;
+	for ( ; i + 4 <= n; i += 4 )
+	{
+		__m256i x = _mm256_loadu_si256( (const __m256i*)( a + i ) );
+		__m256i y = _mm256_loadu_si256( (const __m256i*)( b + i ) );
+		_mm256_storeu_si256( (__m256i*)( out + i ), fixMulShiftAVX2( x, y, FIX_HALF ) );
+	}
+	fixMulBatchScalar( out + i, a + i, b + i, n - i );
+}
+
+FIX_TARGET_AVX512 static void fixMulBatchAVX512( fixed_t* out, const fixed_t* a, const fixed_t* b, size_t n )
+{
+	size_t i = 0;
+	for ( ; i + 8 <= n; i += 8 )
+	{
+		__m512i x = _mm512_loadu_si512( (const void*)( a + i ) );
+		__m512i y = _mm512_loadu_si512( (const void*)( b + i ) );
+		_mm512_storeu_si512( (void*)( out + i ), fixMulShiftAVX512( x, y, FIX_HALF ) );
+	}
+	fixMulBatchScalar( out + i, a + i, b + i, n - i );
+}
+
+FIX_TARGET_AVX2 static void fixDotBatchAVX2( fixed_t* out, const fixed_t* ax, const fixed_t* ay, const fixed_t* az,
+	const fixed_t* bx, const fixed_t* by, const fixed_t* bz, size_t n )
+{
+	const __m256i mask = _mm256_set1_epi64x( 0xffff );
+	size_t i = 0;
+	for ( ; i + 4 <= n; i += 4 )
+	{
+		__m256i x = _mm256_loadu_si256( (const __m256i*)( ax + i ) ), u = _mm256_loadu_si256( (const __m256i*)( bx + i ) );
+		__m256i y = _mm256_loadu_si256( (const __m256i*)( ay + i ) ), v = _mm256_loadu_si256( (const __m256i*)( by + i ) );
+		__m256i z = _mm256_loadu_si256( (const __m256i*)( az + i ) ), w = _mm256_loadu_si256( (const __m256i*)( bz + i ) );
+		__m256i q = _mm256_add_epi64( _mm256_add_epi64( fixMulShiftAVX2( x, u, 0 ), fixMulShiftAVX2( y, v, 0 ) ), fixMulShiftAVX2( z, w, 0 ) );
+		__m256i rem = _mm256_add_epi64( _mm256_add_epi64( _mm256_and_si256( _mm256_mul_epu32( x, u ), mask ),
+			_mm256_and_si256( _mm256_mul_epu32( y, v ), mask ) ), _mm256_and_si256( _mm256_mul_epu32( z, w ), mask ) );
+		q = _mm256_add_epi64( q, _mm256_srli_epi64( _mm256_add_epi64( rem, _mm256_set1_epi64x( FIX_HALF ) ), 16 ) );
+		_mm256_storeu_si256( (__m256i*)( out + i ), q );
+	}
+	fixDotBatchScalar( out + i, ax + i, ay + i, az + i, bx + i, by + i, bz + i, n - i );
+}
+
+FIX_TARGET_AVX512 static void fixDotBatchAVX512( fixed_t* out, const fixed_t* ax, const fixed_t* ay, const fixed_t* az,
+	const fixed_t* bx, const fixed_t* by, const fixed_t* bz, size_t n )
+{
+	const __m512i mask = _mm512_set1_epi64( 0xffff );
+	size_t i = 0;
+	for ( ; i + 8 <= n; i += 8 )
+	{
+		__m512i x = _mm512_loadu_si512( (const void*)( ax + i ) ), u = _mm512_loadu_si512( (const void*)( bx + i ) );
+		__m512i y = _mm512_loadu_si512( (const void*)( ay + i ) ), v = _mm512_loadu_si512( (const void*)( by + i ) );
+		__m512i z = _mm512_loadu_si512( (const void*)( az + i ) ), w = _mm512_loadu_si512( (const void*)( bz + i ) );
+		__m512i q = _mm512_add_epi64( _mm512_add_epi64( fixMulShiftAVX512( x, u, 0 ), fixMulShiftAVX512( y, v, 0 ) ), fixMulShiftAVX512( z, w, 0 ) );
+		__m512i rem = _mm512_add_epi64( _mm512_add_epi64( _mm512_and_si512( _mm512_mul_epu32( x, u ), mask ),
+			_mm512_and_si512( _mm512_mul_epu32( y, v ), mask ) ), _mm512_and_si512( _mm512_mul_epu32( z, w ), mask ) );
+		q = _mm512_add_epi64( q, _mm512_srli_epi64( _mm512_add_epi64( rem, _mm512_set1_epi64( FIX_HALF ) ), 16 ) );
+		_mm512_storeu_si512( (void*)( out + i ), q );
+	}
+	fixDotBatchScalar( out + i, ax + i, ay + i, az + i, bx + i, by + i, bz + i, n - i );
+}
+#endif
+
+// Each API has its own dispatch slot. The constructor selects once after the runtime
+// CPUID/XGETBV checks in __builtin_cpu_supports; other platforms remain scalar.
+static fixMulBatchFn fixMulBatchSite = fixMulBatchScalar;
+static fixDotBatchFn fixDotBatchSite = fixDotBatchScalar;
+
+#if FIX_BATCH_X86
+__attribute__((constructor)) static void fixBatchInit( void )
+{
+	__builtin_cpu_init();
+	if ( __builtin_cpu_supports( "avx512f" ) && __builtin_cpu_supports( "avx512dq" ) )
+	{
+		fixMulBatchSite = fixMulBatchAVX512;
+		fixDotBatchSite = fixDotBatchAVX512;
+	}
+	else if ( __builtin_cpu_supports( "avx2" ) )
