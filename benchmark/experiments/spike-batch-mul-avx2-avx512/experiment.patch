+		fixMulBatchSite = fixMulBatchAVX2;
+		fixDotBatchSite = fixDotBatchAVX2;
+	}
+}
+#endif
+
+void fixMulBatch( fixed_t* out, const fixed_t* a, const fixed_t* b, size_t n )
+{
