+
+// --- batch entry points (spike-batch-ops-neon) ---
+// Each row hashes FOUR lanes per input, built from the input's slots by fixed permutations,
+// so the vector body (four lanes per step) runs on the oracle's own inputs and not only the
+// scalar tail. A tree without the batch API computes the same four lanes with the scalar
+// functions; the hashes were frozen from that scalar computation on the base tree, so a
+// matching hash is the batch path equal to the scalar loop. Fills: "In32" draws every slot
+// inside int32 (the mul/length/cross gate), "In30" inside int30 (the dot gate), "Mixed"
+// draws each slot's magnitude tier (inside, at and past each gate, and full range).
+static void fillBatchShifted( fixOracleInput* in, fixOracleRng* rng, int shift )
+{
+	for ( int i = 0; i < 6; ++i ) in->s[i] = ( int64_t )oracleRngNext( rng ) >> shift;
+}
+static void fillBatchIn32( fixOracleInput* in, uint64_t index, fixOracleRng* rng )
+{
+	( void )index;
+	fillBatchShifted( in, rng, 32 );
+}
+static void fillBatchIn30( fixOracleInput* in, uint64_t index, fixOracleRng* rng )
+{
+	( void )index;
+	fillBatchShifted( in, rng, 33 );
+}
+static void fillBatchMixed( fixOracleInput* in, uint64_t index, fixOracleRng* rng )
+{
+	static const int shifts[6] = { 34, 33, 32, 31, 30, 0 };
+	( void )index;
+	for ( int i = 0; i < 6; ++i )
+	{
+		int shift = shifts[oracleRngNext( rng ) % 6];
+		in->s[i] = ( int64_t )oracleRngNext( rng ) >> shift;
+	}
+}
+static void oracleBatchLanes( const fixOracleInput* in, fixed_t lanes[6][4] )
+{
+	static const int perm[4][6] = { { 0, 1, 2, 3, 4, 5 }, { 1, 2, 0, 4, 5, 3 }, { 3, 4, 5, 0, 1, 2 }, { 2, 0, 1, 5, 3, 4 } };
+	for ( int l = 0; l < 4; ++l )
+		for ( int k = 0; k < 6; ++k ) lanes[k][l] = in->s[perm[l][k]];
+}
+static void applyMulBatch( const fixOracleInput* in, fixOracleOutput* out )
+{
+	const fixed_t a[4] = { in->s[0], in->s[1], in->s[0], in->s[1] };
+	const fixed_t b[4] = { in->s[1], in->s[0], in->s[0], in->s[1] };
+	fixed_t r[4];
+#if defined( FIX_HAVE_BATCH_API )
+	fixMulBatch( r, a, b, 4 );
+#else
+	for ( int l = 0; l < 4; ++l ) r[l] = fixMul( a[l], b[l] );
+#endif
+	for ( int l = 0; l < 4; ++l ) out->s[l] = r[l];
+	out->n = 4;
+}
+static void applyDotBatch3Kind( const fixOracleInput* in, fixOracleOutput* out, int kind )
+{
+	fixed_t L[6][4];
+	fixVec3 va[4], vb[4];
+	fixed_t r[4];
+	oracleBatchLanes( in, L );
+	for ( int l = 0; l < 4; ++l )
+	{
+		va[l] = oracleVec( L[0][l], L[1][l], L[2][l] );
+		vb[l] = oracleVec( L[3][l], L[4][l], L[5][l] );
+	}
+#if defined( FIX_HAVE_BATCH_API )
+	if ( kind == 0 ) fixDotBatch3( r, L[0], L[1], L[2], L[3], L[4], L[5], 4 );
+	else if ( kind == 1 ) fixDotBatch3AoS( r, va, vb, 4 );
+	else fixDotBatch3AoSLd3( r, va, vb, 4 );
+#else
+	( void )kind;
+	for ( int l = 0; l < 4; ++l ) r[l] = fixDot( va[l], vb[l] );
+#endif
+	for ( int l = 0; l < 4; ++l ) out->s[l] = r[l];
+	out->n = 4;
+}
+static void applyDotBatch3( const fixOracleInput* in, fixOracleOutput* out ) { applyDotBatch3Kind( in, out, 0 ); }
+static void applyDotBatch3AoS( const fixOracleInput* in, fixOracleOutput* out ) { applyDotBatch3Kind( in, out, 1 ); }
+static void applyDotBatch3AoSLd3( const fixOracleInput* in, fixOracleOutput* out ) { applyDotBatch3Kind( in, out, 2 ); }
+static void applyLengthBatch( const fixOracleInput* in, fixOracleOutput* out )
+{
+	const fixed_t x[4] = { in->s[0], in->s[1], in->s[2], in->s[0] };
+	const fixed_t y[4] = { in->s[1], in->s[2], in->s[0], in->s[0] };
+	const fixed_t z[4] = { in->s[2], in->s[0], in->s[1], in->s[0] };
+	fixed_t r[4];
+#if defined( FIX_HAVE_BATCH_API )
+	fixLengthBatch( r, x, y, z, 4 );
+#else
+	for ( int l = 0; l < 4; ++l ) r[l] = fixLength( oracleVec( x[l], y[l], z[l] ) );
+#endif
+	for ( int l = 0; l < 4; ++l ) out->s[l] = r[l];
+	out->n = 4;
+}
+static void applyCrossBatch( const fixOracleInput* in, fixOracleOutput* out )
+{
+	fixed_t L[6][4];
+	fixed_t ox[4], oy[4], oz[4];
+	oracleBatchLanes( in, L );
+#if defined( FIX_HAVE_BATCH_API )
+	fixCrossBatch( ox, oy, oz, L[0], L[1], L[2], L[3], L[4], L[5], 4 );
+#else
+	for ( int l = 0; l < 4; ++l )
+	{
+		fixVec3 c = fixCross( oracleVec( L[0][l], L[1][l], L[2][l] ), oracleVec( L[3][l], L[4][l], L[5][l] ) );
+		ox[l] = c.x;
+		oy[l] = c.y;
+		oz[l] = c.z;
+	}
+#endif
+	for ( int l = 0; l < 4; ++l )
+	{
+		out->s[l] = ox[l];
+		out->s[4 + l] = oy[l];
+		out->s[8 + l] = oz[l];
+	}
+	out->n = 12;
+}
