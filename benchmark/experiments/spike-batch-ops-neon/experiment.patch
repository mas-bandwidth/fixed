+	for ( size_t i = 0; i < n; ++i, ++nbCompared ) CHECK( nbOut[0][i] == fixMul( nbA[0][off + i], nbA[3][off + i] ) );
+
+	fixDotBatch3( nbOut[0], nbA[0] + off, nbA[1] + off, nbA[2] + off, nbA[3] + off, nbA[4] + off, nbA[5] + off, n );
+	for ( size_t i = 0; i < n; ++i, ++nbCompared ) CHECK( nbOut[0][i] == fixDot( nbVa[i], nbVb[i] ) );
+	fixDotBatch3AoS( nbOut[1], nbVa, nbVb, n );
+	for ( size_t i = 0; i < n; ++i, ++nbCompared ) CHECK( nbOut[1][i] == fixDot( nbVa[i], nbVb[i] ) );
+	fixDotBatch3AoSLd3( nbOut[2], nbVa, nbVb, n );
+	for ( size_t i = 0; i < n; ++i, ++nbCompared ) CHECK( nbOut[2][i] == fixDot( nbVa[i], nbVb[i] ) );
+
+	fixLengthBatch( nbOut[0], nbA[0] + off, nbA[1] + off, nbA[2] + off, n );
+	for ( size_t i = 0; i < n; ++i, ++nbCompared ) CHECK( nbOut[0][i] == fixLength( nbVa[i] ) );
+
+	fixCrossBatch( nbOut[0], nbOut[1], nbOut[2], nbA[0] + off, nbA[1] + off, nbA[2] + off, nbA[3] + off,
+				   nbA[4] + off, nbA[5] + off, n );
+	for ( size_t i = 0; i < n; ++i, ++nbCompared )
+	{
+		fixVec3 c = fixCross( nbVa[i], nbVb[i] );
+		CHECK( nbOut[0][i] == c.x && nbOut[1][i] == c.y && nbOut[2][i] == c.z );
+	}
+}
+#endif
+
+static void NeonBatchEquivalenceTest( void )
+{
+#if NEON_BATCH_TARGET && !defined( FIX_HAVE_BATCH_API )
+	printf( "FAIL %s:%d: NeonBatchEquivalenceTest: no batch API (fixMulBatch, fixDotBatch3, ...) on aarch64\n",
+			__FILE__, __LINE__ );
+	fails++;
+#elif !NEON_BATCH_TARGET
+	printf( "SKIP: NeonBatchEquivalenceTest (no NEON on this target; a SKIP is not a pass)\n" );
+#else
+	const int failsBefore = fails;
+	// Seeded batches: every lane from one tier, then mixed tiers (one lane past the gate
+	// sends the whole call down the scalar loop).
+	for ( int t = 0; t < 6; ++t )
+	{
+		for ( int rep = 0; rep < 8; ++rep )
+		{
+			for ( int k = 0; k < 6; ++k )
+				for ( int i = 0; i < 1024; ++i )
+					nbA[k][i] = nbDraw( t < 5 ? nbShifts[t] : nbShifts[nbNext() % 5] );
+			nbCheckAll( 0, 1024 );
+		}
+	}
+	// One lane at the boundary, every other lane deep inside: the scan must see it wherever
+	// it sits (main loop, the second accumulator, the tail).
+	{
+		static const fixed_t edge[] = { (fixed_t)1 << 29, -( (fixed_t)1 << 30 ), ( (fixed_t)1 << 30 ) - 1,
+										(fixed_t)1 << 30, -( ( (fixed_t)1 << 30 ) + 1 ), ( (fixed_t)1 << 31 ) - 1,
+										-( (fixed_t)1 << 31 ), (fixed_t)1 << 31, -( ( (fixed_t)1 << 31 ) + 1 ),
+										INT64_MAX, INT64_MIN, FIX_MAX, FIX_MIN };
+		for ( size_t e = 0; e < sizeof edge / sizeof edge[0]; ++e )
+		{
+			for ( size_t pos = 0; pos < 11; ++pos )
+			{
+				for ( int k = 0; k < 6; ++k )
+					for ( int i = 0; i < 11; ++i ) nbA[k][i] = nbDraw( 34 );
+				nbA[(int)( e % 6 )][pos] = edge[e];
+				nbCheckAll( 0, 11 );
+			}
+		}
+	}
+	// The structured grid (0, +-1, +-2^k, +-(2^k - 1), the extremes, the saturation values),
+	// crossed with itself: lane j of a batch of the grid's size pairs grid[i] with grid[j].
+	{
+		static fixed_t grid[300];
+		int g = 0;
+		grid[g++] = 0; grid[g++] = 1; grid[g++] = -1; grid[g++] = FIX_ONE; grid[g++] = -FIX_ONE;
+		grid[g++] = FIX_HALF; grid[g++] = INT64_MAX; grid[g++] = INT64_MIN; grid[g++] = FIX_MIN;
+		for ( int k = 1; k <= 62; ++k )
+		{
+			fixed_t p = (fixed_t)1 << k;
+			grid[g++] = p; grid[g++] = -p; grid[g++] = p - 1; grid[g++] = -( p - 1 );
+		}
+		for ( int i = 0; i < g; ++i )
+		{
+			for ( int j = 0; j < g; ++j )
+			{
+				nbA[0][j] = grid[i];
+				nbA[1][j] = grid[j];
+				nbA[2][j] = grid[( i + j ) % g];
+				nbA[3][j] = grid[j];
+				nbA[4][j] = grid[i];
+				nbA[5][j] = grid[( i * 7 + j * 3 ) % g];
+			}
+			nbCheckAll( 0, (size_t)g );
+			// The same lanes with only the grid values that pass each gate: so the vector
+			// path, and not only the fallback, sees every in-range grid pair.
+			for ( int k = 0; k < 6; ++k )
+				for ( int j = 0; j < g; ++j )
+					if ( ( (uint64_t)nbA[k][j] ^ (uint64_t)( nbA[k][j] < 0 ? -1 : 0 ) ) >> 30 ) nbA[k][j] = (fixed_t)( j - g / 2 );
+			nbCheckAll( 0, (size_t)g );
+		}
+	}
+	// Perfect squares and their neighbours near the top of the length gate: (k, 0, 0),
+	// (k, +-1, 0) and (k, k, k) for k just below 2^31 and around powers of two. These reach the
+	// downward repair step; the upward step is NOT exercised here (dropping it fails nothing).
+	for ( int round = 0; round < 4; ++round )
+	{
+		for ( int d = 0; d < 1024; ++d )
+		{
+			fixed_t k = round < 2 ? (fixed_t)( INT64_C( 2147483647 ) - (int64_t)d * ( round == 0 ? 1 : 2097143 ) )
+								  : (fixed_t)( ( INT64_C( 1 ) << ( 16 + d % 15 ) ) + ( d / 15 ) - 34 );
+			nbA[0][d] = k;
+			nbA[1][d] = round == 3 ? k : (fixed_t)( d % 3 ) - 1;
+			nbA[2][d] = round == 3 ? -k : 0;
+			nbA[3][d] = -k;
+			nbA[4][d] = k >> 1;
+			nbA[5][d] = 1;
+		}
+		nbCheckAll( 0, 1024 );
+	}
+	// One below a perfect square: (2t^2, 2t, 0) has squared length (2t^2 + 1)^2 - 1, and near
+	// 2^62 the double conversion can round it up to (or past) the square, so the seed is one
+	// too high and the downward repair step must fire.
+	for ( int d = 0; d < 1024; ++d )
+	{
+		fixed_t t = 32767 - d;
+		nbA[0][d] = 2 * t * t;
+		nbA[1][d] = 2 * t;
+		nbA[2][d] = 0;
+		nbA[3][d] = t;
+		nbA[4][d] = -2 * t * t;
+		nbA[5][d] = d;
+	}
+	nbCheckAll( 0, 1024 );
+	// Tails n = 0..9 and 1023, at offsets 0..3 (unaligned starts), every tier.
+	for ( int t = 0; t < 5; ++t )
+	{
+		for ( int k = 0; k < 6; ++k )
+			for ( int i = 0; i < NB_MAX; ++i ) nbA[k][i] = nbDraw( nbShifts[t] );
+		for ( size_t off = 0; off < 4; ++off )
+		{
+			for ( size_t n = 0; n <= 9; ++n ) nbCheckAll( off, n );
+			nbCheckAll( off, 1023 );
+		}
+	}
+	printf( "NeonBatchEquivalenceTest: compared=%llu fails=%d %s\n", (unsigned long long)nbCompared,
+			fails - failsBefore, fails == failsBefore ? "PASS" : "FAIL" );
+#endif
+}
