+						   opBatchA[4], opBatchA[5], n );
+#else
+			for ( size_t i = 0; i < n; ++i )
+			{
+				fixVec3 c = fixCross( oracleVec( opBatchA[0][i], opBatchA[1][i], opBatchA[2][i] ),
+									  oracleVec( opBatchA[3][i], opBatchA[4][i], opBatchA[5][i] ) );
+				opBatchOut[0][i] = c.x;
+				opBatchOut[1][i] = c.y;
+				opBatchOut[2][i] = c.z;
+			}
+#endif
+		}
+		for ( int w = 0; w < words; ++w )
+			for ( size_t i = 0; i < n; ++i ) sum += ( uint64_t )opBatchOut[w][i];
 	}
 	return sum;
 }
