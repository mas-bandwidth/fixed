+			for ( size_t i = 0; i < n; ++i ) opBatchOut[0][i] = fixDot( opBatchVa[i], opBatchVb[i] );
+#endif
+		}
+		else if ( strncmp( name, "fixDotBatch3", 12 ) == 0 )
+		{
+#if defined( FIX_HAVE_BATCH_API )
+			fixDotBatch3( opBatchOut[0], opBatchA[0], opBatchA[1], opBatchA[2], opBatchA[3], opBatchA[4], opBatchA[5], n );
+#else
+			for ( size_t i = 0; i < n; ++i )
+				opBatchOut[0][i] = fixDot( oracleVec( opBatchA[0][i], opBatchA[1][i], opBatchA[2][i] ),
+										   oracleVec( opBatchA[3][i], opBatchA[4][i], opBatchA[5][i] ) );
+#endif
+		}
+		else if ( strncmp( name, "fixLengthBatch", 14 ) == 0 )
