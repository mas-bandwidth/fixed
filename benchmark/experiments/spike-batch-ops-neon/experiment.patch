+#if defined( FIX_HAVE_BATCH_API )
+			fixMulBatch( opBatchOut[0], opBatchA[0], opBatchA[1], n );
+#else
+			for ( size_t i = 0; i < n; ++i ) opBatchOut[0][i] = fixMul( opBatchA[0][i], opBatchA[1][i] );
+#endif
+		}
+		else if ( strcmp( name, "fixDotBatch3AoS" ) == 0 )
+		{
+#if defined( FIX_HAVE_BATCH_API )
+			fixDotBatch3AoS( opBatchOut[0], opBatchVa, opBatchVb, n );
