+# THE NEON BATCH SPIKE. test/neon_batch_test.c holds NeonBatchEquivalenceTest, which needs
+# the aarch64 NEON path in fixed_vec.h; it is compiled only there. Elsewhere it is skipped by
+# name (not built), and a SKIP is not a pass in the report.
+if (CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64|ARM64")
+    add_executable(fixed_neon_batch_test test/neon_batch_test.c)
+    target_link_libraries(fixed_neon_batch_test PRIVATE fixed)
+    add_test(NAME neon_batch COMMAND fixed_neon_batch_test)
+endif()
