+			vst1q_s64( ox + i + 2, xh );
+			vst1q_s64( oy + i, yl );
+			vst1q_s64( oy + i + 2, yh );
+			vst1q_s64( oz + i, zl );
+			vst1q_s64( oz + i + 2, zh );
