+// ================================================================================
+// THE FAST-TIER DIVIDE. The reciprocal Newton path for a 128-bit dividend and a
+// 64-bit divisor, held to a long-division reference that shares no arithmetic with it,
+// and to native __int128 where the compiler has it.
+// ================================================================================
+
+// Reference: shift-subtract long division written on the emulated pair, independent of the
+// reciprocal path. hi < d is not required by the loop; the callers here only exercise the
+// hi < d and the split-full 128/64 shapes.
+static void refDiv128by64( uint64_t hi, uint64_t lo, uint64_t d, uint64_t* qOut, uint64_t* rOut )
+{
+	fixEmuUInt128 n = fixEmuUInt128Make( hi, lo );
+	fixEmuUInt128 div = fixEmuUInt128FromU64( d );
+	fixEmuUInt128 rem = fixEmuUInt128Make( 0, 0 );
+	fixEmuUInt128 quo = fixEmuUInt128Make( 0, 0 );
+	for ( int i = 127; i >= 0; i-- )
+	{
+		uint64_t bit = ( i < 64 ) ? ( ( n.lo >> i ) & 1 ) : ( ( n.hi >> ( i - 64 ) ) & 1 );
+		rem = fixEmuUInt128Shl( rem, 1 );
+		rem.lo |= bit;
+		if ( fixEmuUInt128Ge( rem, div ) )
+		{
+			rem = fixEmuUInt128Sub( rem, div );
+			quo = fixEmuUInt128Or( quo, fixEmuUInt128Shl( fixEmuUInt128FromU64( 1 ), i ) );
+		}
+	}
+	*qOut = fixEmuUInt128Lo( quo );
+	*rOut = fixEmuUInt128Lo( rem );
+}
+
+static uint64_t sweepDivFastTier( int perturb, uint64_t samples )
+{
+	uint64_t bad = 0;
+
+	// The tier gates: dividends at 2^47 - 1, 2^47, 2^63 and the 2^64 - 1 high limbs, plus
+	// the lane boundaries, crossed with divisors at every power of two +-1 and the edges.
+	static const uint64_t gates[] = {
+		0, 1, 2, 3, UINT64_C( 0xFFFFFFFF ), UINT64_C( 0xFFFFFFFFFFFFFFFF ),
+		0x8000000000000000ULL, 0x7FFFFFFFFFFFFFFFULL,
+		( UINT64_C( 1 ) << 47 ) - 1, UINT64_C( 1 ) << 47,
+		UINT64_C( 1 ) << 63, UINT64_C( 0xFFFFFFFFFFFFFFFE ),
+	};
+	const int gateCount = (int)( sizeof( gates ) / sizeof( gates[0] ) );
+
+	for ( int ai = 0; ai < gateCount; ai++ )
+	{
+		for ( int bi = 0; bi < gateCount; bi++ )
+		{
+			uint64_t d = gates[bi];
+			if ( d == 0 ) continue;
+			uint64_t hi = gates[ai] % d;
+			uint64_t lo = ( gates[ai] << 32 ) ^ ( gates[bi] >> 32 ) ^ (uint64_t)gates[ai];
+
+			// The reciprocal primitive (hi < d).
+			uint64_t qref, rref, q, r;
+			refDiv128by64( hi, lo, d, &qref, &rref );
+			q = bump64( fixEmuUInt128DivRemBy64Recip( hi, lo, d, &r ), perturb );
+			r = bump64( r, perturb );
+			bad += ( q != qref ) + ( r != rref );
+			bad += CHECK_64( qref, refDivQNative( hi, lo, d ) );
+			bad += CHECK_64( rref, refDivRNative( hi, lo, d ) );
+
+			// The full 128/64 path through fixEmuUInt128DivMod (dividend.hi arbitrary).
+			fixEmuUInt128 qq, rr;
+			fixEmuUInt128 n = fixEmuUInt128Make( gates[ai], lo );
+			fixEmuUInt128 dv = fixEmuUInt128FromU64( d );
+			fixEmuUInt128DivMod( n, dv, &qq, &rr );
+			qq = fixEmuUInt128Make( bump64( qq.hi, perturb ), bump64( qq.lo, perturb ) );
+			bad += CHECK_U( qq, refUDiv( (nativeUInt128)n.hi << 64 | n.lo, (nativeUInt128)d ) );
+			bad += CHECK_U( rr, refUMod( (nativeUInt128)n.hi << 64 | n.lo, (nativeUInt128)d ) );
+		}
+	}
+
+	// Divisors at every power of two +-1 against full-width dividends.
+	rngState = 0xD1000000ULL + (uint64_t)perturb;
+	for ( uint64_t i = 0; i < samples; i++ )
+	{
+		uint64_t hi = nextRandom();
+		uint64_t lo = nextRandom();
+		uint64_t d = nextRandom();
+		int k = (int)( nextRandom() % 63 );
+		uint64_t p = UINT64_C( 1 ) << k;
+		switch ( (int)( d & 3 ) )
+		{
+			case 0: d = p; break;
+			case 1: d = ( k == 0 ) ? 1 : p - 1; break;
+			case 2: d = p + 1; break;
+			default: d = ( d == 0 ) ? 1 : d; break;
+		}
+		if ( d == 0 ) d = 1;
+		hi %= d; // keep the primitive precondition hi < d
+
+		uint64_t qref, rref, q, r;
+		refDiv128by64( hi, lo, d, &qref, &rref );
+		q = bump64( fixEmuUInt128DivRemBy64Recip( hi, lo, d, &r ), perturb );
+		r = bump64( r, perturb );
+		bad += ( q != qref ) + ( r != rref );
+		bad += CHECK_64( qref, refDivQNative( hi, lo, d ) );
+		bad += CHECK_64( rref, refDivRNative( hi, lo, d ) );
+	}
+
+	return bad;
+}
