 		case FIX_ISA_AVX512: return FIX_ISA_HAVE_AVX512;
+		case FIX_ISA_AVX512IFMA: return FIX_ISA_HAVE_AVX512IFMA;
 		default: return 0;
 	}
 }
@@ -286,6 +301,12 @@ static void fixIsaInstall( fixIsa isa )
 			fixIsaTable.mulBatch = fixIsaMulBatchAvx512;
 			fixIsaTable.dotBatch3 = fixIsaDotBatch3Avx512;
 			break;
+#endif
+#if FIX_ISA_HAVE_AVX512IFMA
+		case FIX_ISA_AVX512IFMA:
+			fixIsaTable.mulBatch = fixIsaMulBatchAvx512Ifma;
+			fixIsaTable.dotBatch3 = fixIsaDotBatch3Avx512Ifma;
+			break;
 #endif
