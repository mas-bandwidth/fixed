 			fixIsaTable.mulBatch = fixIsaMulBatchScalar;
diff --git a/src/fixed_isa_avx512ifma.c b/src/fixed_isa_avx512ifma.c
new file mode 100644
index 0000000..321a4ac
--- /dev/null
+++ b/src/fixed_isa_avx512ifma.c
@@ -0,0 +1,94 @@
+// SPDX-FileCopyrightText: 2026 Más Bandwidth LLC
+// SPDX-License-Identifier: MIT
+// THE AVX-512 IFMA VARIANT of the batch kernels (spike benchmark/findings/spike-fixed-batch-ifma-zen4.md).
+// vpmadd52luq / vpmadd52huq multiply the low 52 bits of two lanes and add the low or high 52 bits
+// of the 104-bit product to a 64-bit accumulator. Per-function target attribute, reached only
+// through the kernel table after detection found F, DQ, IFMA and the OS zmm state.
+//
+// THE BIT ARGUMENT. Write a = a0 + a1*2^52 and b = b0 + b1*2^52 for the UNSIGNED 64-bit
+// patterns (a0, b0 52 bits; a1, b1 12 bits). Modulo 2^80, which is all that bits 16..79 of
+// the 128-bit product need,
+//   a_u*b_u = a0*b0 + 2^52*(a0*b1 + a1*b0)
+//           = lo52(a0*b0) + 2^52*(hi52(a0*b0) + lo52(a0*b1) + lo52(a1*b0))   (mod 2^80),
+// because only the low 28 bits of the bracket survive and lo52 keeps them. The signed product
+// differs from the unsigned one by 2^64*(sa*b + sb*a) (mod 2^80), sa and sb the sign bits, and
+// only the low 16 bits of that bracket survive. With M = the bracket and S = lo52(a0*b0) + half,
+//   (a*b + half) >> 16 = (S >> 16) + ((M - 2^12*c) << 36)   (mod 2^64),  c = sa*b + sb*a,
+// since M*2^52 is a multiple of 2^16 so the shift is exact on it. For the dot the three
+// products share one accumulator pair (the IFMA add is free): sum of lo52 parts plus half,
+// and the sum of every bracket, rounded once, as fixDot does, including when the 128-bit sum wraps.
+// FIX_SATURATE builds compile none of this: saturation is a different function.
+#include "fixed/fixed_vec.h"
+
+#if ( defined( __x86_64__ ) || defined( _M_X64 ) ) && !defined( FIX_SATURATE ) && \
+	( defined( __GNUC__ ) || defined( __clang__ ) )
+
+	#include <immintrin.h>
+
+	#define FIX_ISA_IFMA_TARGET __attribute__( ( target( "avx512f,avx512dq,avx512ifma" ) ) )
+
+void fixIsaMulBatchScalar( fixed_t* out, const fixed_t* a, const fixed_t* b, size_t n );
+void fixIsaDotBatch3Scalar( fixed_t* out, const fixed_t* ax, const fixed_t* ay, const fixed_t* az,
+							const fixed_t* bx, const fixed_t* by, const fixed_t* bz, size_t n );
+void fixIsaMulBatchAvx512Ifma( fixed_t* out, const fixed_t* a, const fixed_t* b, size_t n );
+void fixIsaDotBatch3Avx512Ifma( fixed_t* out, const fixed_t* ax, const fixed_t* ay, const fixed_t* az,
+								const fixed_t* bx, const fixed_t* by, const fixed_t* bz, size_t n );
+
+// Accumulate one product into (low, mid, corr): low += lo52(a0*b0); mid += hi52(a0*b0) +
+// lo52(a0*b1) + lo52(a1*b0); corr += sa*b + sb*a.
+FIX_ISA_IFMA_TARGET static inline void fixIsaIfmaAccumulate( __m512i a, __m512i b, __m512i* low, __m512i* mid,
+															 __m512i* corr )
+{
+	const __m512i a1 = _mm512_srli_epi64( a, 52 ), b1 = _mm512_srli_epi64( b, 52 );
+	*low = _mm512_madd52lo_epu64( *low, a, b );
+	*mid = _mm512_madd52hi_epu64( *mid, a, b );
+	*mid = _mm512_madd52lo_epu64( *mid, a, b1 );
+	*mid = _mm512_madd52lo_epu64( *mid, a1, b );
+	*corr = _mm512_add_epi64( *corr, _mm512_add_epi64( _mm512_and_si512( _mm512_srai_epi64( a, 63 ), b ),
+													   _mm512_and_si512( _mm512_srai_epi64( b, 63 ), a ) ) );
+}
+
+FIX_ISA_IFMA_TARGET static inline __m512i fixIsaIfmaFinish( __m512i low, __m512i mid, __m512i corr )
+{
+	mid = _mm512_sub_epi64( mid, _mm512_slli_epi64( corr, 12 ) );
+	return _mm512_add_epi64( _mm512_srli_epi64( low, 16 ), _mm512_slli_epi64( mid, 36 ) );
+}
+
+FIX_ISA_IFMA_TARGET void fixIsaMulBatchAvx512Ifma( fixed_t* out, const fixed_t* a, const fixed_t* b, size_t n )
+{
+	const __m512i half = _mm512_set1_epi64( ( int64_t )FIX_HALF );
+	size_t i = 0;
+	for ( ; i + 8 <= n; i += 8 )
+	{
+		__m512i x = _mm512_loadu_si512( ( const void* )( a + i ) );
+		__m512i y = _mm512_loadu_si512( ( const void* )( b + i ) );
+		__m512i low = half, mid = _mm512_setzero_si512(), corr = _mm512_setzero_si512();
+		fixIsaIfmaAccumulate( x, y, &low, &mid, &corr );
+		_mm512_storeu_si512( ( void* )( out + i ), fixIsaIfmaFinish( low, mid, corr ) );
+	}
+	fixIsaMulBatchScalar( out + i, a + i, b + i, n - i );
+}
+
+FIX_ISA_IFMA_TARGET void fixIsaDotBatch3Avx512Ifma( fixed_t* out, const fixed_t* ax, const fixed_t* ay,
+													const fixed_t* az, const fixed_t* bx, const fixed_t* by,
+													const fixed_t* bz, size_t n )
+{
+	const __m512i half = _mm512_set1_epi64( ( int64_t )FIX_HALF );
+	size_t i = 0;
+	for ( ; i + 8 <= n; i += 8 )
+	{
+		__m512i low = half, mid = _mm512_setzero_si512(), corr = _mm512_setzero_si512();
+		fixIsaIfmaAccumulate( _mm512_loadu_si512( ( const void* )( ax + i ) ), _mm512_loadu_si512( ( const void* )( bx + i ) ),
+							  &low, &mid, &corr );
+		fixIsaIfmaAccumulate( _mm512_loadu_si512( ( const void* )( ay + i ) ), _mm512_loadu_si512( ( const void* )( by + i ) ),
+							  &low, &mid, &corr );
+		fixIsaIfmaAccumulate( _mm512_loadu_si512( ( const void* )( az + i ) ), _mm512_loadu_si512( ( const void* )( bz + i ) ),
+							  &low, &mid, &corr );
+		_mm512_storeu_si512( ( void* )( out + i ), fixIsaIfmaFinish( low, mid, corr ) );
+	}
+	fixIsaDotBatch3Scalar( out + i, ax + i, ay + i, az + i, bx + i, by + i, bz + i, n - i );
+}
+
+#else
+typedef int fixIsaAvx512IfmaNotCompiled;
+#endif
diff --git a/test/batch_ifma_test.c b/test/batch_ifma_test.c
new file mode 100644
index 0000000..b05afec
--- /dev/null
+++ b/test/batch_ifma_test.c
@@ -0,0 +1,142 @@
+// SPDX-FileCopyrightText: 2026 Más Bandwidth LLC
+// SPDX-License-Identifier: MIT
+// BatchIfmaEquivalenceTest (spike-fixed-batch-ifma-zen4): the batch_test.c body, run on the
+// avx512ifma variant FORCED by name. If the build does not carry the variant the test FAILS
+// naming it absent (red at BASE); if the host lacks IFMA it prints SKIP and exits 0 (a SKIP is
+// not red and not evidence). Lanes mix full-width draws with draws of random magnitude.
+// BatchIfmaEquivalenceTest: all SIMD lanes, tails, unaligned data and large seeded
+// coverage of fixMulBatch and fixDotBatch3 against the scalar public operations, through
+// whichever variant the runtime dispatch selected on this host (printed on the PASS line).
+// Adopted from benchmark/experiments/spike-batch-mul-avx2-avx512. test/isa_dispatch_test.c
+// runs every variant the host can run; this one runs the default selection, on both 128-bit
+// arms and in the FIX_SATURATE build. The seeded lane count is the optional argument.
+#include "fixed/fixed_isa.h"
+#include "fixed/fixed_vec.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+enum { CAP = 4096 };
+static fixed_t aa[CAP + 1], bb[CAP + 1], cc[CAP + 1];
+static fixed_t dd[CAP + 1], ee[CAP + 1], ff[CAP + 1], gotMul[CAP + 1], gotDot[CAP + 1];
+static fixed_t edges[280];
+static size_t edgeCount;
+static uint64_t rngState = UINT64_C( 0x243f6a8885a308d3 );
+
+static uint64_t nextRand( void )
+{
+	uint64_t x = rngState;
+	x ^= x << 13;
+	x ^= x >> 7;
+	x ^= x << 17;
+	return rngState = x;
+}
+
+static void addEdge( fixed_t value )
+{
+	for ( size_t i = 0; i < edgeCount; ++i ) if ( edges[i] == value ) return;
+	edges[edgeCount++] = value;
+}
+
+static fixed_t drawLane( void )
+{
+	// Half the lanes full width, half with a random magnitude (random bit count, random sign).
+	uint64_t r = nextRand();
+	if ( r & 1 ) return ( fixed_t )nextRand();
+	unsigned bits = ( unsigned )( ( r >> 8 ) % 64 );
+	uint64_t v = nextRand() >> bits;
+	return ( fixed_t )( ( r & 4 ) ? UINT64_C( 0 ) - v : v ); // negation in unsigned arithmetic
+}
+
+static int check( size_t n, uint64_t base )
+{
+	// +1 makes all eight input and output pointers 8-byte aligned but unaligned
+	// relative to either vector register width. The zero-length call is valid.
+	fixed_t *a = aa + 1, *b = bb + 1, *c = cc + 1;
+	fixed_t *d = dd + 1, *e = ee + 1, *f = ff + 1;
+	gotMul[1] = INT64_C( 0x1020304050607080 );
+	gotDot[1] = INT64_C( 0x1020304050607080 );
+	fixMulBatch( gotMul + 1, a, b, n );
+	fixDotBatch3( gotDot + 1, a, b, c, d, e, f, n );
+	if ( n == 0 && ( gotMul[1] != INT64_C( 0x1020304050607080 ) || gotDot[1] != INT64_C( 0x1020304050607080 ) ) ) return 1;
+	for ( size_t i = 0; i < n; ++i )
+	{
+		fixed_t mul = fixMul( a[i], b[i] );
+		fixVec3 v = { a[i], b[i], c[i] }, w = { d[i], e[i], f[i] };
+		fixed_t dot = fixDot( v, w );
+		if ( gotMul[i + 1] != mul || gotDot[i + 1] != dot )
+		{
+			fprintf( stderr, "BatchIfmaEquivalenceTest FAIL at %llu: a=%lld b=%lld mul=%lld expected=%lld dot=%lld expected=%lld\n",
+				(unsigned long long)( base + i ), (long long)a[i], (long long)b[i],
+				(long long)gotMul[i + 1], (long long)mul, (long long)gotDot[i + 1], (long long)dot );
+			return 1;
+		}
+	}
+	return 0;
+}
+
+int main( int argc, char** argv )
+{
+	const uint64_t lanes = argc > 1 ? strtoull( argv[1], NULL, 10 ) : UINT64_C( 100000000 );
+	fixIsaResult forced = fixForceIsa( "avx512ifma" );
+	if ( forced == FIX_ISA_NOT_COMPILED )
+	{
+		printf( "BatchIfmaEquivalenceTest FAIL: variant avx512ifma absent (not compiled into this build)\n" );
+		return 1;
+	}
+	if ( forced == FIX_ISA_HOST_LACKS )
+	{
+		printf( "BatchIfmaEquivalenceTest SKIP: host lacks avx512ifma\n" );
+		return 0;
+	}
+	if ( forced != FIX_ISA_OK ) return 1;
+	addEdge( 0 ); addEdge( 1 ); addEdge( -1 );
+	addEdge( INT64_MIN ); addEdge( INT64_MAX ); addEdge( FIX_MIN ); addEdge( FIX_MAX );
+	for ( unsigned k = 1; k < 63; ++k )
+	{
+		int64_t p = INT64_C( 1 ) << k;
+		addEdge( p ); addEdge( -p ); addEdge( p - 1 ); addEdge( -( p - 1 ) );
+	}
+	const size_t tails[] = { 0, 1, 3, 4, 5, 7, 8, 9, 4095 };
+	for ( size_t t = 0; t < sizeof tails / sizeof tails[0]; ++t )
+	{
+		for ( size_t i = 0; i < tails[t]; ++i )
+		{
+			aa[i + 1] = edges[i % edgeCount]; bb[i + 1] = edges[( i * 19 ) % edgeCount];
+			cc[i + 1] = edges[( i * 29 ) % edgeCount]; dd[i + 1] = edges[( i * 37 ) % edgeCount];
+			ee[i + 1] = edges[( i * 43 ) % edgeCount]; ff[i + 1] = edges[( i * 59 ) % edgeCount];
+		}
+		if ( check( tails[t], 0 ) ) return 1;
+	}
+	uint64_t index = 0;
+	for ( size_t i = 0; i < edgeCount; ++i )
+	{
+		for ( size_t j = 0; j < edgeCount; ++j )
+		{
+			size_t slot = (size_t)( index % 4095 );
+			aa[slot + 1] = edges[i]; bb[slot + 1] = edges[j];
+			cc[slot + 1] = edges[( i + j ) % edgeCount];
+			dd[slot + 1] = edges[j]; ee[slot + 1] = edges[i];
+			ff[slot + 1] = edges[( i * 7 + j * 11 ) % edgeCount];
+			++index;
+			if ( slot == 4094 && check( 4095, index - 4095 ) ) return 1;
+		}
+	}
+	if ( index % 4095 && check( (size_t)( index % 4095 ), index - index % 4095 ) ) return 1;
+	for ( uint64_t base = 0; base < lanes; base += 4095 )
+	{
+		size_t n = (size_t)( lanes - base );
+		if ( n > 4095 ) n = 4095;
+		for ( size_t i = 0; i < n; ++i )
+		{
+			const int mixed = ( base / 4095 ) & 1;
+			aa[i + 1] = mixed ? drawLane() : (fixed_t)nextRand(); bb[i + 1] = mixed ? drawLane() : (fixed_t)nextRand();
+			cc[i + 1] = mixed ? drawLane() : (fixed_t)nextRand(); dd[i + 1] = mixed ? drawLane() : (fixed_t)nextRand();
+			ee[i + 1] = mixed ? drawLane() : (fixed_t)nextRand(); ff[i + 1] = mixed ? drawLane() : (fixed_t)nextRand();
+		}
+		if ( check( n, base ) ) return 1;
+	}
+	printf( "BatchIfmaEquivalenceTest PASS: variant %s; %zu structured edges crossed; %llu seeded lanes; mul and dot\n",
+		fixIsaName(), edgeCount, (unsigned long long)lanes );
+	return 0;
+}
