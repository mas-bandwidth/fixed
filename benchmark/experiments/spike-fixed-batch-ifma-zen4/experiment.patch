diff --git a/benchmark/experiments/spike-fixed-batch-ifma-zen4/ifma_micro.c b/benchmark/experiments/spike-fixed-batch-ifma-zen4/ifma_micro.c
new file mode 100644
index 0000000..b1197c1
--- /dev/null
+++ b/benchmark/experiments/spike-fixed-batch-ifma-zen4/ifma_micro.c
@@ -0,0 +1,65 @@
+// SPDX-FileCopyrightText: 2026 Más Bandwidth LLC
+// SPDX-License-Identifier: MIT
+// Micro benchmark for spike-fixed-batch-ifma-zen4: fixMulBatch and fixDotBatch3 through scalar,
+// avx512 and avx512ifma at n = 16, 256, 4096, interleaved variant by variant within one
+// binary, repeated R times. NOT a unit test: it reads the clock. Iteration counts are arguments.
+//
+//   cc -O3 -DNDEBUG -ffp-contract=off -I include benchmark/experiments/spike-fixed-batch-ifma-zen4/ifma_micro.c src/*.c -lm -o ifma_micro
+//   taskset -c N ./ifma_micro <repeats> <elements-per-rep>
+// Output CSV: op,n,variant,rep,ns_per_element,checksum
+#include "fixed/fixed_isa.h"
+#include "fixed/fixed_vec.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+
+enum { MAXN = 4096 };
+static fixed_t in[6][MAXN + 8], out[MAXN + 8];
+
+static uint64_t rng = UINT64_C( 0x9e3779b97f4a7c15 );
+static uint64_t next( void ) { rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17; return rng; }
+
+static double nowNs( void )
+{
+	struct timespec t;
+	clock_gettime( CLOCK_MONOTONIC, &t );
+	return ( double )t.tv_sec * 1e9 + ( double )t.tv_nsec;
+}
+
+int main( int argc, char** argv )
+{
+	const int repeats = argc > 1 ? atoi( argv[1] ) : 9;
+	const uint64_t elements = argc > 2 ? strtoull( argv[2], NULL, 10 ) : UINT64_C( 40000000 );
+	const char* variants[] = { "scalar", "avx512", "avx512ifma" };
+	const size_t sizes[] = { 16, 256, 4096 };
+	// Realistic fixed-point magnitudes: values around 1000.0 in the library's format.
+	for ( int j = 0; j < 6; ++j )
+		for ( int i = 0; i < MAXN; ++i ) in[j][i] = ( fixed_t )( ( int64_t )( next() >> 20 ) - ( INT64_C( 1 ) << 42 ) );
+	printf( "op,n,variant,rep,ns_per_element,checksum\n" );
+	for ( int op = 0; op < 2; ++op )
+		for ( size_t s = 0; s < 3; ++s )
+			for ( int rep = 0; rep < repeats; ++rep )
+				for ( int v = 0; v < 3; ++v )
+				{
+					if ( fixForceIsa( variants[v] ) != FIX_ISA_OK ) { fprintf( stderr, "cannot force %s\n", variants[v] ); return 2; }
+					const size_t n = sizes[s];
+					const uint64_t calls = elements / n;
+					uint64_t sum = 0;
+					// warm
+					for ( uint64_t c = 0; c < calls / 20 + 1; ++c )
+						op ? fixDotBatch3( out, in[0], in[1], in[2], in[3], in[4], in[5], n ) : fixMulBatch( out, in[0], in[1], n );
+					double t0 = nowNs();
+					for ( uint64_t c = 0; c < calls; ++c )
+					{
+						if ( op ) fixDotBatch3( out, in[0], in[1], in[2], in[3], in[4], in[5], n );
+						else fixMulBatch( out, in[0], in[1], n );
+						__asm__ volatile( "" : : "r"( out ) : "memory" ); // the call is opaque already; belt and braces
+					}
+					double t1 = nowNs();
+					for ( size_t i = 0; i < n; ++i ) sum = sum * 31 + ( uint64_t )out[i];
+					printf( "%s,%zu,%s,%d,%.4f,%llu\n", op ? "fixDotBatch3" : "fixMulBatch", n, variants[v], rep,
+							( t1 - t0 ) / ( double )( calls * n ), ( unsigned long long )sum );
+				}
+	return 0;
+}
