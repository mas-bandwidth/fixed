diff --git a/src/fixed_isa_avx2.c b/src/fixed_isa_avx2.c
new file mode 100644
index 0000000..51c0053
--- /dev/null
+++ b/src/fixed_isa_avx2.c
@@ -0,0 +1,56 @@
+// SPDX-FileCopyrightText: 2026 Más Bandwidth LLC
+// SPDX-License-Identifier: MIT
+// THE AVX2 VARIANT of fixMulBatch ONLY (the dot kernel stays scalar: it lost, 0.675x, in
+// benchmark/findings/spike-batch-mul-avx2-avx512.md). SPIKE spike-fixed-batch-mul-avx2-floor.
+//
+// Same bit argument as src/fixed_isa_avx512.c: with c = b >> 16 (arithmetic) and
+// blo = b & 65535, modulo 2^64
+//   (a*b + half) >> 16 = a*c + (ah*blo << 16) + ((al*blo + half) >> 16),  a = ah*2^32 + al.
+// AVX2 has no 64-bit multiply and no 64-bit arithmetic shift, so:
+//   c       = ((b >>> 16) ^ 2^47) - 2^47            (sign-extend the 48-bit field)
+//   low64(a*c) = al*cl + ((ah*cl + al*ch) << 32)     (vpmuludq x3; the cross terms need
+//                                                     only their low 32 bits, signedness moot)
+//   ah*blo  = vpmuldq(a >>> 32, blo), al*blo = vpmuludq(a, blo).
+// Five vpmuludq/vpmuldq per four lanes.
+#include "fixed/fixed_vec.h"
+
+#if ( defined( __x86_64__ ) || defined( _M_X64 ) ) && !defined( FIX_SATURATE ) && \
+	( defined( __GNUC__ ) || defined( __clang__ ) )
+
+	#include <immintrin.h>
+	#define FIX_ISA_AVX2_TARGET __attribute__( ( target( "avx2" ) ) )
+
+void fixIsaMulBatchScalar( fixed_t* out, const fixed_t* a, const fixed_t* b, size_t n );
+void fixIsaMulBatchAvx2( fixed_t* out, const fixed_t* a, const fixed_t* b, size_t n );
+
+FIX_ISA_AVX2_TARGET static inline __m256i fixIsaMulShiftAvx2( __m256i a, __m256i b, __m256i half )
+{
+	const __m256i mask = _mm256_set1_epi64x( 0xffff );
+	const __m256i sign = _mm256_set1_epi64x( INT64_C( 1 ) << 47 );
+	__m256i c = _mm256_sub_epi64( _mm256_xor_si256( _mm256_srli_epi64( b, 16 ), sign ), sign );
+	__m256i ah = _mm256_srli_epi64( a, 32 );
+	__m256i ch = _mm256_srli_epi64( c, 32 );
+	__m256i blo = _mm256_and_si256( b, mask );
+	__m256i cross = _mm256_add_epi64( _mm256_mul_epu32( ah, c ), _mm256_mul_epu32( a, ch ) );
+	__m256i first = _mm256_add_epi64( _mm256_mul_epu32( a, c ), _mm256_slli_epi64( cross, 32 ) );
+	__m256i high = _mm256_slli_epi64( _mm256_mul_epi32( ah, blo ), 16 );
+	__m256i low = _mm256_srli_epi64( _mm256_add_epi64( _mm256_mul_epu32( a, blo ), half ), 16 );
+	return _mm256_add_epi64( first, _mm256_add_epi64( high, low ) );
+}
+
+FIX_ISA_AVX2_TARGET void fixIsaMulBatchAvx2( fixed_t* out, const fixed_t* a, const fixed_t* b, size_t n )
+{
+	const __m256i half = _mm256_set1_epi64x( ( int64_t )FIX_HALF );
+	size_t i = 0;
+	for ( ; i + 4 <= n; i += 4 )
+	{
+		__m256i x = _mm256_loadu_si256( ( const __m256i* )( a + i ) );
+		__m256i y = _mm256_loadu_si256( ( const __m256i* )( b + i ) );
+		_mm256_storeu_si256( ( __m256i* )( out + i ), fixIsaMulShiftAvx2( x, y, half ) );
+	}
+	fixIsaMulBatchScalar( out + i, a + i, b + i, n - i );
+}
+
+#else
+typedef int fixIsaAvx2NotCompiled;
+#endif
diff --git a/test/batch_mul_avx2_test.c b/test/batch_mul_avx2_test.c
new file mode 100644
index 0000000..a10c4cf
--- /dev/null
+++ b/test/batch_mul_avx2_test.c
@@ -0,0 +1,137 @@
+// SPDX-FileCopyrightText: 2026 Más Bandwidth LLC
+// SPDX-License-Identifier: MIT
+// BatchMulAvx2EquivalenceTest: the AVX2 fixMulBatch variant against scalar fixMul. Forces
+// FIXED_ISA=avx2 through fixForceIsa and holds every output lane bit-identical to fixMul on
+// the structured edge grid crossed with itself, every tail length around the 4-lane width,
+// unaligned pointers (data starts one element in), and the seeded full-width lanes (the count
+// is the optional argument, default 100 million). No clock, no files, no network.
+//   - RED at a tree with no avx2 variant: fixForceIsa("avx2") is NOT_COMPILED -> FAIL.
+//   - FIX_SATURATE builds compile scalar only: the test then requires the refusal by name.
+//   - A host without AVX2 prints SKIP (a SKIP is not a pass of the variant).
+#include "fixed/fixed_isa.h"
+#include "fixed/fixed_vec.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#if defined( FIX_SATURATE )
+	#define EXPECT_COMPILED 0
+#else
+	#define EXPECT_COMPILED 1
+#endif
+
+enum { CAP = 4096 };
+static fixed_t aa[CAP + 1], bb[CAP + 1], got[CAP + 1];
+static fixed_t edges[280];
+static size_t edgeCount;
+static uint64_t rngState = UINT64_C( 0x9e3779b97f4a7c15 );
+
+static uint64_t nextRand( void )
+{
+	uint64_t x = rngState;
+	x ^= x << 13;
+	x ^= x >> 7;
+	x ^= x << 17;
+	return rngState = x;
+}
+
+static void addEdge( fixed_t value )
+{
+	for ( size_t i = 0; i < edgeCount; ++i )
+		if ( edges[i] == value ) return;
+	edges[edgeCount++] = value;
+}
+
+static int check( size_t n, uint64_t base )
+{
+	fixed_t *a = aa + 1, *b = bb + 1;
+	got[1] = INT64_C( 0x1020304050607080 );
+	fixMulBatch( got + 1, a, b, n );
+	if ( n == 0 && got[1] != INT64_C( 0x1020304050607080 ) ) return 1;
+	for ( size_t i = 0; i < n; ++i )
+	{
+		fixed_t want = fixMul( a[i], b[i] );
+		if ( got[i + 1] != want )
+		{
+			fprintf( stderr, "BatchMulAvx2EquivalenceTest FAIL at %llu: a=%lld b=%lld got=%lld want=%lld\n",
+					 ( unsigned long long )( base + i ), ( long long )a[i], ( long long )b[i], ( long long )got[i + 1],
+					 ( long long )want );
+			return 1;
+		}
+	}
+	return 0;
+}
+
+int main( int argc, char** argv )
+{
+	const uint64_t lanes = argc > 1 ? strtoull( argv[1], NULL, 10 ) : UINT64_C( 100000000 );
+	fixIsaResult r = fixForceIsa( "avx2" );
+	if ( !EXPECT_COMPILED )
+	{
+		if ( r != FIX_ISA_NOT_COMPILED )
+		{
+			printf( "BatchMulAvx2EquivalenceTest FAIL: this build must not carry avx2 (result %d)\n", ( int )r );
+			return 1;
+		}
+		printf( "BatchMulAvx2EquivalenceTest PASS: avx2 refused by name in a scalar-only build\n" );
+		return 0;
+	}
+	if ( r == FIX_ISA_NOT_COMPILED )
+	{
+		printf( "BatchMulAvx2EquivalenceTest FAIL: avx2 variant absent (not compiled)\n" );
+		return 1;
+	}
+	if ( r == FIX_ISA_HOST_LACKS )
+	{
+		printf( "BatchMulAvx2EquivalenceTest SKIP: host lacks avx2\n" );
+		return 0;
+	}
+	if ( r != FIX_ISA_OK || fixIsaSelected() != FIX_ISA_AVX2 )
+	{
+		printf( "BatchMulAvx2EquivalenceTest FAIL: fixForceIsa(avx2) = %d\n", ( int )r );
+		return 1;
+	}
+
+	addEdge( 0 ); addEdge( 1 ); addEdge( -1 );
+	addEdge( INT64_MIN ); addEdge( INT64_MAX ); addEdge( FIX_MIN ); addEdge( FIX_MAX );
+	addEdge( FIX_HALF ); addEdge( FIX_HALF - 1 ); addEdge( -FIX_HALF ); addEdge( 65535 ); addEdge( 65536 );
+	addEdge( INT64_C( 0xffffffff ) ); addEdge( INT64_C( 0x100000000 ) ); addEdge( -INT64_C( 0x100000000 ) );
+	addEdge( INT64_C( 0x7fffffff ) ); addEdge( INT64_C( 0x80000000 ) ); addEdge( -INT64_C( 0x80000000 ) );
+	for ( unsigned k = 1; k < 63; ++k )
+	{
+		int64_t p = INT64_C( 1 ) << k;
+		addEdge( p ); addEdge( -p ); addEdge( p - 1 ); addEdge( -( p - 1 ) );
+	}
+	uint64_t done = 0;
+	// The edge grid crossed with itself: row i of the grid is a[] = edge i, b[] = every edge.
+	for ( size_t i = 0; i < edgeCount; ++i )
+	{
+		for ( size_t j = 0; j < edgeCount; ++j )
+			aa[j + 1] = edges[i], bb[j + 1] = edges[j];
+		if ( check( edgeCount, done ) ) return 1;
+		done += edgeCount;
+	}
+	printf( "edge grid %zu x %zu bit-identical\n", edgeCount, edgeCount );
+	// Every tail length 0..33 on random and on edge lanes.
+	for ( size_t n = 0; n <= 33; ++n )
+	{
+		for ( size_t i = 0; i < n; ++i )
+			aa[i + 1] = ( fixed_t )nextRand(), bb[i + 1] = edges[nextRand() % edgeCount];
+		if ( check( n, done ) ) return 1;
+		for ( size_t i = 0; i < n; ++i )
+			aa[i + 1] = edges[nextRand() % edgeCount], bb[i + 1] = ( fixed_t )nextRand();
+		if ( check( n, done ) ) return 1;
+	}
+	done = 0;
+	while ( done < lanes )
+	{
+		size_t n = lanes - done < CAP ? ( size_t )( lanes - done ) : ( size_t )CAP;
+		for ( size_t i = 0; i < n; ++i )
+			aa[i + 1] = ( fixed_t )nextRand(), bb[i + 1] = ( fixed_t )nextRand();
+		if ( check( n, done ) ) return 1;
+		done += n;
+	}
+	printf( "BatchMulAvx2EquivalenceTest PASS: variant %s, edge grid, tails, unaligned, %llu seeded lanes\n",
+			fixIsaName(), ( unsigned long long )done );
+	return 0;
+}
