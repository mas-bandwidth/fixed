diff --git a/src/fixed_isa_neon.c b/src/fixed_isa_neon.c
new file mode 100644
index 0000000..221676d
--- /dev/null
+++ b/src/fixed_isa_neon.c
@@ -0,0 +1,219 @@
+// SPDX-FileCopyrightText: 2026 Más Bandwidth LLC
+// SPDX-License-Identifier: MIT
+// THE NEON VARIANT of the batch kernels (aarch64 AdvSIMD, 128-bit lanes). Experiment of
+// spike-fixed-batch-neon-on-m5, ported from the archived spike-batch-ops-neon patch.
+//
+// NEON has no 64-bit lane multiply. So the kernels escape through int32: an EXACTNESS GATE
+// proves that every operand of the whole call fits a signed 32-bit lane (|x| <= 2^31, and
+// |x| <= 2^30 for the three-term dot), and then smull/smlal produce the exact 64-bit products and one srshr is exactly
+// fixMul's (p + FIX_HALF) >> FIX_FRACTION_BITS on a product that already fits 64 bits. The gate
+// is one OR-of-magnitudes scan per call over every operand array, x ^ (x >> 63), which is below
+// 2^(k-1) exactly when x fits a signed k-bit lane. It is inside every call. When it fails the
+// WHOLE call is the scalar kernel, so every output equals the scalar function by construction
+// on that side and by the gate on this one.
+//
+// GATE WIDTHS. Two int32 operands multiply to at most 2^62 in magnitude, exact in an int64
+// lane, so mul uses the int32 gate. Three such products reach 3 * 2^62 > 2^63, so the
+// three-term signed dot uses the int30 gate: 3 * 2^60 < 2^63, and the sum is rounded once.
+//
+// NEON is baseline on aarch64, so this file needs no target attribute and no compile flag.
+// FIX_SATURATE builds compile none of it: saturation is a different function.
+// -DFIX_NEON_BROKEN_GATE widens each gate by one bit (a deliberately wrong kernel): the
+// BatchNeonEquivalenceTest build that defines it MUST fail (a witness that the test sees a
+// gate one bit too wide).
+#include "fixed/fixed_vec.h"
+
+#if ( defined( __aarch64__ ) || defined( _M_ARM64 ) ) && !defined( FIX_SATURATE ) && \
+	( defined( __GNUC__ ) || defined( __clang__ ) )
+
+	#include <arm_neon.h>
+
+	#if defined( FIX_NEON_BROKEN_GATE )
+		#define FIX_NEON_GATE_MUL 32
+		#define FIX_NEON_GATE_DOT 31
+	#else
+		#define FIX_NEON_GATE_MUL 31
+		#define FIX_NEON_GATE_DOT 30
+	#endif
+
+void fixIsaMulBatchScalar( fixed_t* out, const fixed_t* a, const fixed_t* b, size_t n );
+void fixIsaDotBatch3Scalar( fixed_t* out, const fixed_t* ax, const fixed_t* ay, const fixed_t* az,
+							const fixed_t* bx, const fixed_t* by, const fixed_t* bz, size_t n );
+void fixIsaMulBatchNeon( fixed_t* out, const fixed_t* a, const fixed_t* b, size_t n );
+void fixIsaDotBatch3Neon( fixed_t* out, const fixed_t* ax, const fixed_t* ay, const fixed_t* az,
+						  const fixed_t* bx, const fixed_t* by, const fixed_t* bz, size_t n );
+void fixIsaLengthBatchScalar( fixed_t* out, const fixed_t* x, const fixed_t* y, const fixed_t* z, size_t n );
+void fixIsaCrossBatchScalar( fixed_t* ox, fixed_t* oy, fixed_t* oz, const fixed_t* ax, const fixed_t* ay,
+							 const fixed_t* az, const fixed_t* bx, const fixed_t* by, const fixed_t* bz, size_t n );
+void fixIsaLengthBatchNeon( fixed_t* out, const fixed_t* x, const fixed_t* y, const fixed_t* z, size_t n );
+void fixIsaCrossBatchNeon( fixed_t* ox, fixed_t* oy, fixed_t* oz, const fixed_t* ax, const fixed_t* ay,
+						   const fixed_t* az, const fixed_t* bx, const fixed_t* by, const fixed_t* bz, size_t n );
+
+// OR over the array of x ^ (x >> 63). Below 2^(k-1) iff every element fits a signed k-bit lane.
+static uint64x2_t fixIsaNeonMagnitudeOr( const fixed_t* v, size_t n )
+{
+	uint64x2_t acc0 = vdupq_n_u64( 0 );
+	uint64x2_t acc1 = vdupq_n_u64( 0 );
+	size_t i = 0;
+	for ( ; i + 4 <= n; i += 4 )
+	{
+		int64x2_t x0 = vld1q_s64( v + i );
+		int64x2_t x1 = vld1q_s64( v + i + 2 );
+		acc0 = vorrq_u64( acc0, vreinterpretq_u64_s64( veorq_s64( x0, vshrq_n_s64( x0, 63 ) ) ) );
+		acc1 = vorrq_u64( acc1, vreinterpretq_u64_s64( veorq_s64( x1, vshrq_n_s64( x1, 63 ) ) ) );
+	}
+	uint64x2_t acc = vorrq_u64( acc0, acc1 );
+	for ( ; i < n; ++i )
+	{
+		int64x2_t x = vdupq_n_s64( v[i] );
+		acc = vorrq_u64( acc, vreinterpretq_u64_s64( veorq_s64( x, vshrq_n_s64( x, 63 ) ) ) );
+	}
+	return acc;
+}
+
+static inline uint64_t fixIsaNeonFold( uint64x2_t acc ) { return vgetq_lane_u64( acc, 0 ) | vgetq_lane_u64( acc, 1 ); }
+
+// Four consecutive int64 (already proven to fit int32) -> one int32x4: the low halves.
+static inline int32x4_t fixIsaNeonNarrow4( const fixed_t* p )
+{
+	return vuzp1q_s32( vreinterpretq_s32_s64( vld1q_s64( p ) ), vreinterpretq_s32_s64( vld1q_s64( p + 2 ) ) );
+}
+
+void fixIsaMulBatchNeon( fixed_t* out, const fixed_t* a, const fixed_t* b, size_t n )
+{
+	size_t i = 0;
+	uint64x2_t m = vorrq_u64( fixIsaNeonMagnitudeOr( a, n ), fixIsaNeonMagnitudeOr( b, n ) );
+	if ( ( fixIsaNeonFold( m ) >> FIX_NEON_GATE_MUL ) == 0 )
+	{
+		for ( ; i + 4 <= n; i += 4 )
+		{
+			int32x4_t av = fixIsaNeonNarrow4( a + i );
+			int32x4_t bv = fixIsaNeonNarrow4( b + i );
+			int64x2_t lo = vmull_s32( vget_low_s32( av ), vget_low_s32( bv ) );
+			int64x2_t hi = vmull_high_s32( av, bv );
+			vst1q_s64( out + i, vrshrq_n_s64( lo, FIX_FRACTION_BITS ) );
+			vst1q_s64( out + i + 2, vrshrq_n_s64( hi, FIX_FRACTION_BITS ) );
+		}
+	}
+	fixIsaMulBatchScalar( out + i, a + i, b + i, n - i );
+}
+
+void fixIsaDotBatch3Neon( fixed_t* out, const fixed_t* ax, const fixed_t* ay, const fixed_t* az, const fixed_t* bx,
+						  const fixed_t* by, const fixed_t* bz, size_t n )
+{
+	size_t i = 0;
+	uint64x2_t m = vorrq_u64( vorrq_u64( fixIsaNeonMagnitudeOr( ax, n ), fixIsaNeonMagnitudeOr( ay, n ) ),
+							  vorrq_u64( fixIsaNeonMagnitudeOr( az, n ), fixIsaNeonMagnitudeOr( bx, n ) ) );
+	m = vorrq_u64( m, vorrq_u64( fixIsaNeonMagnitudeOr( by, n ), fixIsaNeonMagnitudeOr( bz, n ) ) );
+	if ( ( fixIsaNeonFold( m ) >> FIX_NEON_GATE_DOT ) == 0 )
+	{
+		for ( ; i + 4 <= n; i += 4 )
+		{
+			int32x4_t vax = fixIsaNeonNarrow4( ax + i ), vbx = fixIsaNeonNarrow4( bx + i );
+			int32x4_t vay = fixIsaNeonNarrow4( ay + i ), vby = fixIsaNeonNarrow4( by + i );
+			int32x4_t vaz = fixIsaNeonNarrow4( az + i ), vbz = fixIsaNeonNarrow4( bz + i );
+			// smull, smlal, smlal (and the high halves), then one srshr: fixDot rounds once.
+			int64x2_t lo = vmull_s32( vget_low_s32( vax ), vget_low_s32( vbx ) );
+			int64x2_t hi = vmull_high_s32( vax, vbx );
+			lo = vmlal_s32( lo, vget_low_s32( vay ), vget_low_s32( vby ) );
+			hi = vmlal_high_s32( hi, vay, vby );
+			lo = vmlal_s32( lo, vget_low_s32( vaz ), vget_low_s32( vbz ) );
+			hi = vmlal_high_s32( hi, vaz, vbz );
+			vst1q_s64( out + i, vrshrq_n_s64( lo, FIX_FRACTION_BITS ) );
+			vst1q_s64( out + i + 2, vrshrq_n_s64( hi, FIX_FRACTION_BITS ) );
+		}
+	}
+	fixIsaDotBatch3Scalar( out + i, ax + i, ay + i, az + i, bx + i, by + i, bz + i, n - i );
+}
+
+// Exact floor square root of two u64 lanes below 3 * 2^62. The double seed is within one of the
+// floor (the input rounds by 2^-53 relative, the root by half an ulp of a value below 2^32:
+// together far below one unit), and one downward and one upward step repair it to the exact
+// integer floor. Squares are formed with umull on the 32-bit root, so they are exact.
+static inline uint64x2_t fixIsaNeonISqrt2( uint64x2_t n )
+{
+	uint64x2_t r = vcvtq_u64_f64( vsqrtq_f64( vcvtq_f64_u64( n ) ) );
+	uint32x2_t r32 = vmovn_u64( r );
+	uint64x2_t rr = vmull_u32( r32, r32 );
+	r = vaddq_u64( r, vcgtq_u64( rr, n ) ); // r*r > n: r - 1 (the mask is all ones = -1)
+	r32 = vmovn_u64( r );
+	rr = vmull_u32( r32, r32 );
+	r = vsubq_u64( r, vcgtq_u64( vsubq_u64( n, rr ), vshlq_n_u64( r, 1 ) ) ); // n - r*r > 2r: r + 1
+	return r;
+}
+
+// fixLength is the exact integer floor square root of the sum of squares (Q32.32 -> Q16.16).
+// With every component inside int32 each square is <= 2^62 and non-negative, the three sum
+// below 3 * 2^62 < 2^64, exact in an unsigned lane, and the 128-bit scalar sum has a zero high
+// word, so the floor root of that u64 is exactly fixISqrt128High's answer.
+void fixIsaLengthBatchNeon( fixed_t* out, const fixed_t* x, const fixed_t* y, const fixed_t* z, size_t n )
+{
+	size_t i = 0;
+	uint64x2_t m = vorrq_u64( fixIsaNeonMagnitudeOr( x, n ), vorrq_u64( fixIsaNeonMagnitudeOr( y, n ), fixIsaNeonMagnitudeOr( z, n ) ) );
+	if ( ( fixIsaNeonFold( m ) >> FIX_NEON_GATE_MUL ) == 0 )
+	{
+		for ( ; i + 4 <= n; i += 4 )
+		{
+			int32x4_t xv = fixIsaNeonNarrow4( x + i );
+			int32x4_t yv = fixIsaNeonNarrow4( y + i );
+			int32x4_t zv = fixIsaNeonNarrow4( z + i );
+			int64x2_t lo = vmull_s32( vget_low_s32( xv ), vget_low_s32( xv ) );
+			int64x2_t hi = vmull_high_s32( xv, xv );
+			lo = vmlal_s32( lo, vget_low_s32( yv ), vget_low_s32( yv ) );
+			hi = vmlal_high_s32( hi, yv, yv );
+			lo = vmlal_s32( lo, vget_low_s32( zv ), vget_low_s32( zv ) );
+			hi = vmlal_high_s32( hi, zv, zv );
+			vst1q_s64( out + i, vreinterpretq_s64_u64( fixIsaNeonISqrt2( vreinterpretq_u64_s64( lo ) ) ) );
+			vst1q_s64( out + i + 2, vreinterpretq_s64_u64( fixIsaNeonISqrt2( vreinterpretq_u64_s64( hi ) ) ) );
+		}
+	}
+	fixIsaLengthBatchScalar( out + i, x + i, y + i, z + i, n - i );
+}
+
+static inline int64x2_t fixIsaNeonMulLo( int32x4_t a, int32x4_t b )
+{
+	return vrshrq_n_s64( vmull_s32( vget_low_s32( a ), vget_low_s32( b ) ), FIX_FRACTION_BITS );
+}
+static inline int64x2_t fixIsaNeonMulHi( int32x4_t a, int32x4_t b )
+{
+	return vrshrq_n_s64( vmull_high_s32( a, b ), FIX_FRACTION_BITS );
+}
+
+// fixCross rounds each product on its own (fixMul), then subtracts once, so the vector form is
+// six rounded smull products per component pair and a vsubq_s64 (the differences of values below
+// 2^47 cannot wrap).
+void fixIsaCrossBatchNeon( fixed_t* ox, fixed_t* oy, fixed_t* oz, const fixed_t* ax, const fixed_t* ay,
+						   const fixed_t* az, const fixed_t* bx, const fixed_t* by, const fixed_t* bz, size_t n )
+{
+	size_t i = 0;
+	uint64x2_t m = vorrq_u64( vorrq_u64( fixIsaNeonMagnitudeOr( ax, n ), fixIsaNeonMagnitudeOr( ay, n ) ),
+							  vorrq_u64( fixIsaNeonMagnitudeOr( az, n ), fixIsaNeonMagnitudeOr( bx, n ) ) );
+	m = vorrq_u64( m, vorrq_u64( fixIsaNeonMagnitudeOr( by, n ), fixIsaNeonMagnitudeOr( bz, n ) ) );
+	if ( ( fixIsaNeonFold( m ) >> FIX_NEON_GATE_MUL ) == 0 )
+	{
+		for ( ; i + 4 <= n; i += 4 )
+		{
+			int32x4_t vax = fixIsaNeonNarrow4( ax + i ), vay = fixIsaNeonNarrow4( ay + i ), vaz = fixIsaNeonNarrow4( az + i );
+			int32x4_t vbx = fixIsaNeonNarrow4( bx + i ), vby = fixIsaNeonNarrow4( by + i ), vbz = fixIsaNeonNarrow4( bz + i );
+			int64x2_t xl = vsubq_s64( fixIsaNeonMulLo( vay, vbz ), fixIsaNeonMulLo( vaz, vby ) );
+			int64x2_t xh = vsubq_s64( fixIsaNeonMulHi( vay, vbz ), fixIsaNeonMulHi( vaz, vby ) );
+			int64x2_t yl = vsubq_s64( fixIsaNeonMulLo( vaz, vbx ), fixIsaNeonMulLo( vax, vbz ) );
+			int64x2_t yh = vsubq_s64( fixIsaNeonMulHi( vaz, vbx ), fixIsaNeonMulHi( vax, vbz ) );
+			int64x2_t zl = vsubq_s64( fixIsaNeonMulLo( vax, vby ), fixIsaNeonMulLo( vay, vbx ) );
+			int64x2_t zh = vsubq_s64( fixIsaNeonMulHi( vax, vby ), fixIsaNeonMulHi( vay, vbx ) );
+			vst1q_s64( ox + i, xl );
+			vst1q_s64( ox + i + 2, xh );
+			vst1q_s64( oy + i, yl );
+			vst1q_s64( oy + i + 2, yh );
+			vst1q_s64( oz + i, zl );
+			vst1q_s64( oz + i + 2, zh );
+		}
+	}
+	fixIsaCrossBatchScalar( ox + i, oy + i, oz + i, ax + i, ay + i, az + i, bx + i, by + i, bz + i, n - i );
+}
+
+#else
+// Not compiled on this target (or a FIX_SATURATE build). ISO C forbids an empty
+// translation unit.
+typedef int fixIsaNeonNotCompiled;
+#endif
diff --git a/test/batch_neon_equivalence_test.c b/test/batch_neon_equivalence_test.c
new file mode 100644
index 0000000..d038260
--- /dev/null
+++ b/test/batch_neon_equivalence_test.c
@@ -0,0 +1,319 @@
+// SPDX-FileCopyrightText: 2026 Más Bandwidth LLC
+// SPDX-License-Identifier: MIT
+// BatchNeonEquivalenceTest: the NEON variant of the batch kernels (fixMulBatch, fixDotBatch3,
+// fixLengthBatch, fixCrossBatch) against the scalar public operations (fixMul, fixDot,
+// fixLength, fixCross), output word by output word.
+//
+// The NEON kernels run a vector body only when an exactness gate proves every operand fits a
+// 32-bit lane (mul) or a 30-bit lane (the three-term dot); otherwise the whole call is the
+// scalar loop. So full-width random lanes exercise only the fallback, and this test therefore
+// draws lanes in magnitude tiers: inside the gate, exactly at it, just past it, and full width.
+// It also walks the structured edge grid crossed with itself, a boundary value at every lane
+// position, every tail length 0..33 and unaligned pointers. The seeded lane count is the
+// argument (default 100 million); it counts lanes with a counter and uses no clock.
+//
+// On aarch64 a build WITHOUT the neon variant is RED: fixForceIsa("neon") not OK is a FAIL, not
+// a skip. Elsewhere the variant does not exist and the test says SKIP by name; a SKIP is not a
+// pass. A FIX_SATURATE build keeps the scalar route, so there the test pins that "neon" is
+// refused as not compiled. -DNEON_EQUIV_NEGATIVE_CONTROL perturbs the reference by one ulp on
+// one lane per 1024: that build MUST fail (tests the test).
+#include "fixed/fixed_isa.h"
+#include "fixed/fixed_vec.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+// The length and cross entry points exist only once this experiment's header declares them; a
+// tree without them (BASE) still runs, and fails, on the absent variant first.
+#if defined( FIX_HAVE_BATCH_LENGTH_CROSS )
+	#define HAVE_LC 1
+#else
+	#define HAVE_LC 0
+#endif
+
+#if ( defined( __aarch64__ ) || defined( _M_ARM64 ) ) && !defined( FIX_SATURATE )
+	#define EXPECT_NEON 1
+#else
+	#define EXPECT_NEON 0
+#endif
+
+#if defined( NEON_EQUIV_NEGATIVE_CONTROL )
+	#define CONTROL_NUDGE( i ) ( ( ( i ) & 1023 ) == 517 ? 1 : 0 )
+#else
+	#define CONTROL_NUDGE( i ) 0
+#endif
+
+static int fails = 0;
+static uint64_t compared = 0, vectorLanes = 0;
+
+enum { CAP = 4096, PAD = 2 };
+static fixed_t in[6][CAP + PAD], outMul[CAP + PAD], outDot[CAP + PAD], outLen[CAP + PAD], outCross[3][CAP + PAD];
+static uint64_t rngState = UINT64_C( 0x243f6a8885a308d3 );
+
+static uint64_t nextRand( void )
+{
+	uint64_t x = rngState;
+	x ^= x << 13;
+	x ^= x >> 7;
+	x ^= x << 17;
+	return rngState = x;
+}
+
+// x ^ (x >> 63): below 2^(k-1) exactly when x fits a signed k-bit lane. Restated here, in the
+// test, so a change to the kernel's gate that this test does not know about shows as a count
+// mismatch in the vectorLanes line, and so the evidence says how many lanes took the vector path.
+static uint64_t mag( fixed_t x ) { return ( uint64_t )x ^ ( uint64_t )( x < 0 ? -1 : 0 ); }
+static int gateMul( const fixed_t* a, const fixed_t* b, size_t n )
+{
+	uint64_t m = 0;
+	for ( size_t i = 0; i < n; ++i ) m |= mag( a[i] ) | mag( b[i] );
+	return ( m >> 31 ) == 0;
+}
+static int gateAll6( size_t n ) // length and cross: the int32 gate over every array they read
+{
+	uint64_t m = 0;
+	for ( int k = 0; k < 6; ++k )
+		for ( size_t i = 1; i <= n; ++i ) m |= mag( in[k][i] );
+	return ( m >> 31 ) == 0;
+}
+static int gateLen( size_t n )
+{
+	uint64_t m = 0;
+	for ( int k = 0; k < 3; ++k )
+		for ( size_t i = 1; i <= n; ++i ) m |= mag( in[k][i] );
+	return ( m >> 31 ) == 0;
+}
+static int gateDot( size_t n )
+{
+	uint64_t m = 0;
+	for ( int k = 0; k < 6; ++k )
+		for ( size_t i = 1; i <= n; ++i ) m |= mag( in[k][i] );
+	return ( m >> 30 ) == 0;
+}
+
+// Runs both kernels on lanes 1..n of in[] (one element past the start: unaligned to any vector
+// width) and compares every output word with the scalar operation. Returns 0 on the first miss.
+static int checkBatch( size_t n )
+{
+	for ( size_t i = 0; i <= n + 1; ++i )
+		outMul[i] = outDot[i] = outLen[i] = outCross[0][i] = outCross[1][i] = outCross[2][i] = INT64_C( 0x1020304050607080 );
+	fixMulBatch( outMul + 1, in[0] + 1, in[1] + 1, n );
+	fixDotBatch3( outDot + 1, in[0] + 1, in[1] + 1, in[2] + 1, in[3] + 1, in[4] + 1, in[5] + 1, n );
+#if HAVE_LC
+	fixLengthBatch( outLen + 1, in[0] + 1, in[1] + 1, in[2] + 1, n );
+	fixCrossBatch( outCross[0] + 1, outCross[1] + 1, outCross[2] + 1, in[0] + 1, in[1] + 1, in[2] + 1, in[3] + 1, in[4] + 1,
+				   in[5] + 1, n );
+#endif
+	// the words around the output must be untouched
+	if ( outMul[0] != INT64_C( 0x1020304050607080 ) || outMul[n + 1] != INT64_C( 0x1020304050607080 ) ||
+		 outDot[0] != INT64_C( 0x1020304050607080 ) || outDot[n + 1] != INT64_C( 0x1020304050607080 ) ||
+		 outLen[0] != INT64_C( 0x1020304050607080 ) || outLen[n + 1] != INT64_C( 0x1020304050607080 ) ||
+		 outCross[0][0] != INT64_C( 0x1020304050607080 ) || outCross[2][n + 1] != INT64_C( 0x1020304050607080 ) )
+	{
+		printf( "FAIL %s:%d: neon wrote outside its %zu lanes\n", __FILE__, __LINE__, n );
+		return 0;
+	}
+	for ( size_t i = 1; i <= n; ++i, ++compared )
+	{
+		fixVec3 a = { in[0][i], in[1][i], in[2][i] }, b = { in[3][i], in[4][i], in[5][i] };
+		fixed_t wantMul = fixMul( in[0][i], in[1][i] ) + CONTROL_NUDGE( i );
+		fixed_t wantDot = fixDot( a, b );
+#if HAVE_LC
+		fixed_t wantLen = fixLength( a );
+		fixVec3 wantCross = fixCross( a, b );
+#else
+		fixed_t wantLen = outLen[i];
+		fixVec3 wantCross = { outCross[0][i], outCross[1][i], outCross[2][i] };
+#endif
+		if ( outMul[i] != wantMul || outDot[i] != wantDot || outLen[i] != wantLen || outCross[0][i] != wantCross.x ||
+			 outCross[1][i] != wantCross.y || outCross[2][i] != wantCross.z )
+		{
+			printf( "FAIL %s:%d: lane %zu of %zu: a=%lld b=%lld mul=%lld want %lld; dot=%lld want %lld; len=%lld want %lld; "
+					"cross=%lld,%lld,%lld want %lld,%lld,%lld\n",
+					__FILE__, __LINE__, i - 1, n, ( long long )in[0][i], ( long long )in[1][i], ( long long )outMul[i],
+					( long long )wantMul, ( long long )outDot[i], ( long long )wantDot, ( long long )outLen[i],
+					( long long )wantLen, ( long long )outCross[0][i], ( long long )outCross[1][i],
+					( long long )outCross[2][i], ( long long )wantCross.x, ( long long )wantCross.y,
+					( long long )wantCross.z );
+			return 0;
+		}
+	}
+	if ( gateMul( in[0] + 1, in[1] + 1, n ) ) vectorLanes += n; // mul vector body: n rounded down to 4, counted whole
+	if ( gateDot( n ) ) vectorLanes += n;
+	if ( gateLen( n ) ) vectorLanes += n;
+	if ( gateAll6( n ) ) vectorLanes += n;
+	return 1;
+}
+
+// Magnitude tiers as arithmetic right shifts of a full 64-bit draw: >>34 inside int30, >>33
+// the int31 range, >>32 exactly the int32 range (passes the mul gate, fails the dot gate),
+// >>31 just past int32 (fails both), 0 full width.
+static const int tierShift[5] = { 34, 33, 32, 31, 0 };
+static fixed_t draw( int shift ) { return ( fixed_t )( ( int64_t )nextRand() >> shift ); }
+
+static void tailsAndTiers( void )
+{
+	for ( int tier = 0; tier < 5; ++tier )
+		for ( size_t n = 0; n <= 33 && fails == 0; ++n )
+			for ( int rep = 0; rep < 16; ++rep )
+			{
+				for ( int k = 0; k < 6; ++k )
+					for ( size_t i = 1; i <= n; ++i ) in[k][i] = draw( tierShift[tier] );
+				if ( !checkBatch( n ) ) ++fails;
+			}
+}
+
+// One boundary value in one array at every lane position of an 11-lane and a 37-lane batch,
+// every other lane deep inside the gate: the scan must see it wherever it sits (the main loop,
+// the second accumulator, the tail).
+static void gateEdges( void )
+{
+	static const fixed_t edge[] = { ( fixed_t )1 << 29, -( ( fixed_t )1 << 30 ), ( ( fixed_t )1 << 30 ) - 1,
+									( fixed_t )1 << 30, -( ( ( fixed_t )1 << 30 ) + 1 ), ( ( fixed_t )1 << 31 ) - 1,
+									-( ( fixed_t )1 << 31 ), ( fixed_t )1 << 31, -( ( ( fixed_t )1 << 31 ) + 1 ),
+									INT64_MAX, INT64_MIN, FIX_MAX, FIX_MIN, -1, 0 };
+	static const size_t sizes[2] = { 11, 37 };
+	for ( size_t s = 0; s < 2; ++s )
+		for ( size_t e = 0; e < sizeof edge / sizeof edge[0]; ++e )
+			for ( size_t pos = 1; pos <= sizes[s]; ++pos )
+				for ( int arr = 0; arr < 6; ++arr )
+				{
+					for ( int k = 0; k < 6; ++k )
+						for ( size_t i = 1; i <= sizes[s]; ++i ) in[k][i] = draw( 34 );
+					in[arr][pos] = edge[e];
+					if ( !checkBatch( sizes[s] ) ) ++fails;
+					if ( fails ) return;
+				}
+}
+
+// The structured grid (0, +-1, +-2^k, +-(2^k - 1), the extremes), crossed with itself: row i of
+// lane j pairs grid[i] with grid[j]. Run raw (most rows fail a gate and take the fallback) and
+// with out-of-gate values replaced, so the vector path sees every in-range grid pair.
+static void gridCross( void )
+{
+	static fixed_t grid[300];
+	int g = 0;
+	grid[g++] = 0, grid[g++] = 1, grid[g++] = -1, grid[g++] = FIX_ONE, grid[g++] = -FIX_ONE;
+	grid[g++] = FIX_HALF, grid[g++] = INT64_MAX, grid[g++] = INT64_MIN, grid[g++] = FIX_MIN;
+	for ( int k = 1; k <= 62; ++k )
+	{
+		fixed_t p = ( fixed_t )1 << k;
+		grid[g++] = p, grid[g++] = -p, grid[g++] = p - 1, grid[g++] = -( p - 1 );
+	}
+	for ( int pass = 0; pass < 3 && fails == 0; ++pass )
+		for ( int i = 0; i < g && fails == 0; ++i )
+		{
+			for ( int j = 0; j < g; ++j )
+			{
+				in[0][j + 1] = grid[i];
+				in[1][j + 1] = grid[j];
+				in[2][j + 1] = grid[( i + j ) % g];
+				in[3][j + 1] = grid[j];
+				in[4][j + 1] = grid[i];
+				in[5][j + 1] = grid[( i * 7 + j * 3 ) % g];
+			}
+			if ( pass > 0 ) // keep only values that pass the mul gate (pass 1) or the dot gate (pass 2)
+				for ( int k = 0; k < 6; ++k )
+					for ( int j = 1; j <= g; ++j )
+						if ( ( mag( in[k][j] ) >> ( pass == 1 ? 31 : 30 ) ) != 0 ) in[k][j] = ( fixed_t )( j - g / 2 );
+			if ( !checkBatch( ( size_t )g ) ) ++fails;
+		}
+}
+
+// fixLength is an exact integer floor square root: lanes whose sum of squares sits ON a perfect
+// square, one below it, and one above it (k*k, (k-1)^2 + 1 + ... ) are where a seed that is one
+// off would show, so they are built directly, at every magnitude up to the int32 limit.
+static void perfectSquares( void )
+{
+	for ( int rep = 0; rep < 400 && fails == 0; ++rep )
+	{
+		const int shift = rep % 4 == 0 ? 32 : rep % 4 == 1 ? 33 : rep % 4 == 2 ? 40 : 34;
+		for ( size_t i = 1; i <= 4096; ++i )
+		{
+			fixed_t k = draw( shift );
+			if ( shift == 32 && ( i & 7 ) == 0 ) k = ( i & 8 ) ? ( fixed_t )INT32_MAX - ( fixed_t )( i >> 4 ) : -( fixed_t )INT32_MAX - 1 + ( fixed_t )( i >> 4 );
+			const fixed_t sgn = ( nextRand() & 1 ) ? -1 : 1;
+			switch ( i & 3 )
+			{
+				case 0: in[0][i] = k, in[1][i] = 0, in[2][i] = 0; break;                 // k*k
+				case 1: in[0][i] = k, in[1][i] = sgn, in[2][i] = 0; break;               // k*k + 1
+				case 2: in[0][i] = k < 0 ? k + 1 : k - 1, in[1][i] = 1, in[2][i] = 1; break; // (k-1)^2 + 2
+				default: in[0][i] = k, in[1][i] = -k, in[2][i] = k; break;               // 3*k*k
+			}
+			for ( int j = 3; j < 6; ++j ) in[j][i] = draw( 34 );
+		}
+		if ( !checkBatch( 4096 ) ) ++fails;
+	}
+}
+
+static void seeded( uint64_t lanes )
+{
+	uint64_t done = 0;
+	unsigned batch = 0;
+	while ( done < lanes && fails == 0 )
+	{
+		size_t n = lanes - done < CAP ? ( size_t )( lanes - done ) : ( size_t )CAP;
+		// every batch is one tier; tier 5 mixes tiers lane by lane (one wide lane sends the
+		// whole call down the scalar loop)
+		const unsigned tier = batch++ % 6;
+		for ( int k = 0; k < 6; ++k )
+			for ( size_t i = 1; i <= n; ++i ) in[k][i] = draw( tier < 5 ? tierShift[tier] : tierShift[nextRand() % 5] );
+		if ( !checkBatch( n ) ) ++fails;
+		done += n;
+	}
+}
+
+int main( int argc, char** argv )
+{
+	const uint64_t lanes = argc > 1 ? strtoull( argv[1], NULL, 10 ) : UINT64_C( 100000000 );
+	printf( "SUBTEST BatchNeonEquivalenceTest\n" );
+#if !EXPECT_NEON
+	{
+	#if defined( FIX_SATURATE )
+		// The saturating build compiles scalar only: the kernels wrap, saturation is a different function.
+		if ( fixForceIsa( "neon" ) != FIX_ISA_NOT_COMPILED )
+		{
+			printf( "FAIL %s:%d: a FIX_SATURATE build must refuse neon as not compiled\n", __FILE__, __LINE__ );
+			return 1;
+		}
+		printf( "VARIANT neon SKIP not compiled in a FIX_SATURATE build (scalar route kept; a SKIP is not a pass)\n" );
+	#else
+		printf( "VARIANT neon SKIP no NEON on this target (a SKIP is not a pass)\n" );
+	#endif
+		printf( "BatchNeonEquivalenceTest PASS (variant absent by design here)\n" );
+		return 0;
+	}
+#else
+	fixIsaResult forced = fixForceIsa( "neon" );
+	if ( forced != FIX_ISA_OK )
+	{
+		printf( "FAIL %s:%d: BatchNeonEquivalenceTest: variant neon ABSENT on aarch64 (fixForceIsa returned %d: %s)\n",
+				__FILE__, __LINE__, ( int )forced,
+				forced == FIX_ISA_NOT_COMPILED ? "not compiled into this build"
+				: forced == FIX_ISA_HOST_LACKS ? "host lacks a fact"
+												: "unknown name" );
+		return 1;
+	}
+	if ( strcmp( fixIsaName(), "neon" ) != 0 )
+	{
+		printf( "FAIL %s:%d: forced neon but the table holds %s\n", __FILE__, __LINE__, fixIsaName() );
+		return 1;
+	}
+	tailsAndTiers();
+	gateEdges();
+	gridCross();
+	perfectSquares();
+	seeded( lanes );
+	if ( fails )
+	{
+		printf( "BatchNeonEquivalenceTest FAIL\n" );
+		return 1;
+	}
+	printf( "VARIANT neon RAN: %llu lanes compared bit-identical to fixMul/fixDot/fixLength/fixCross (%llu lane-operations in calls whose gate passed: vector body)\n",
+			( unsigned long long )compared, ( unsigned long long )vectorLanes );
+	printf( "BatchNeonEquivalenceTest PASS\n" );
+	return 0;
+#endif
+}
