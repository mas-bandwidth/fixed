 	ORACLE_OUT1( out, oracleBatchFold( r ) );
 }
+static void applyLengthBatch( const fixOracleInput* in, fixOracleOutput* out )
+{
+	fixed_t v[3][ORACLE_BATCH_LANES], r[ORACLE_BATCH_LANES];
+	for ( int j = 0; j < 3; ++j )
+		for ( int k = 0; k < ORACLE_BATCH_LANES; ++k ) v[j][k] = in->s[j];
+	fixLengthBatch( r, v[0], v[1], v[2], ORACLE_BATCH_LANES );
+	ORACLE_OUT1( out, oracleBatchFold( r ) );
+}
+static void applyCrossBatch( const fixOracleInput* in, fixOracleOutput* out )
+{
+	fixed_t v[6][ORACLE_BATCH_LANES], r[3][ORACLE_BATCH_LANES];
+	for ( int j = 0; j < 6; ++j )
+		for ( int k = 0; k < ORACLE_BATCH_LANES; ++k ) v[j][k] = in->s[j];
+	fixCrossBatch( r[0], r[1], r[2], v[0], v[1], v[2], v[3], v[4], v[5], ORACLE_BATCH_LANES );
+	out->s[0] = oracleBatchFold( r[0] );
+	out->s[1] = oracleBatchFold( r[1] );
+	out->s[2] = oracleBatchFold( r[2] );
+	out->n = 3;
+}
 static void applyCross( const fixOracleInput* in, fixOracleOutput* out )
 {
 	ORACLE_OUT_VEC( out, fixCross( oracleVec( in->s[0], in->s[1], in->s[2] ), oracleVec( in->s[3], in->s[4], in->s[5] ) ) );
