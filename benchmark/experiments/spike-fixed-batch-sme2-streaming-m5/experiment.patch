@@ -0,0 +1,67 @@
+// SPDX-FileCopyrightText: 2026 Más Bandwidth LLC
+// SPDX-License-Identifier: MIT
+// BatchSme2EquivalenceTest: the SME2 streaming-SVE variant (src/fixed_isa_sme2.c), FORCED,
+// against the scalar public operations. It reuses test/batch_test.c whole (the structured
+// edge grid crossed with itself, tails, unaligned pointers, the seeded full-width lanes;
+// the lane count is the optional argument, 100 million by default) and adds a sweep of every
+// length 0..130 over edge-valued lanes, so the predicated final iteration is hit at every
+// remainder of the streaming vector length. On a host without SME2, or a build that does not
+// compile the variant (FIX_SATURATE), it prints SKIP with the reason: a SKIP is not a pass.
+#define main batchEquivalenceMain
+#include "batch_test.c"
+#undef main
+
+int main( int argc, char** argv )
+{
+	// Whether this build should carry the variant (the condition src/fixed_isa.c uses).
+#if defined( __aarch64__ ) && defined( __clang__ ) && defined( __APPLE__ ) && !defined( FIX_SATURATE ) && \
+	defined( __has_include )
+	#if __has_include( <arm_sme.h> )
+		const int expectCompiled = 1;
+	#else
+		const int expectCompiled = 0;
+	#endif
+#else
+	const int expectCompiled = 0;
+#endif
+	const uint32_t need = FIX_ISA_FACT_SME | FIX_ISA_FACT_SME2;
+	const int hostHas = ( fixIsaHostFacts() & need ) == need;
+	if ( !expectCompiled || !hostHas )
+	{
+		printf( "BatchSme2EquivalenceTest SKIP: %s\n", !expectCompiled ? "this build does not carry the sme2 variant" : "host lacks sme/sme2" );
+		return 0;
+	}
+	// RED AT BASE: a host that has SME2, a build that should carry the variant, and the
+	// variant is not there. That is a failure, not a skip.
+	if ( !fixIsaCompiled( FIX_ISA_SME2 ) )
+	{
+		printf( "BatchSme2EquivalenceTest FAIL: host has sme/sme2 but variant sme2 is absent from this build\n" );
+		return 1;
+	}
+	if ( fixForceIsa( "sme2" ) != FIX_ISA_OK || fixIsaSelected() != FIX_ISA_SME2 )
+	{
+		printf( "BatchSme2EquivalenceTest FAIL: fixForceIsa(\"sme2\") did not select sme2\n" );
+		return 1;
+	}
+	if ( batchEquivalenceMain( argc, argv ) ) return 1;
+	// Every length around the streaming vector length (8 lanes on a 512-bit SVL, up to 32
+	// on a 2048-bit one), edge-valued lanes at a rotating phase.
+	for ( size_t n = 0; n <= 130; ++n )
+	{
+		for ( size_t phase = 0; phase < 5; ++phase )
+		{
+			for ( size_t i = 0; i < n; ++i )
+			{
+				aa[i + 1] = edges[( i + phase ) % edgeCount];
+				bb[i + 1] = edges[( i * 3 + phase * 7 ) % edgeCount];
+				cc[i + 1] = edges[( i * 5 + phase * 11 ) % edgeCount];
+				dd[i + 1] = edges[( i * 13 + phase ) % edgeCount];
+				ee[i + 1] = edges[( i * 17 + phase * 3 ) % edgeCount];
+				ff[i + 1] = edges[( i * 23 + phase * 5 ) % edgeCount];
+			}
+			if ( check( n, 0 ) ) return 1;
+		}
+	}
+	printf( "BatchSme2EquivalenceTest PASS: variant %s forced; every length 0..130 over edge lanes\n", fixIsaName() );
+	return 0;
+}
