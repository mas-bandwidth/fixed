diff --git a/src/fixed_isa_sme2.c b/src/fixed_isa_sme2.c
new file mode 100644
index 0000000..e243220
--- /dev/null
+++ b/src/fixed_isa_sme2.c
@@ -0,0 +1,91 @@
+// SPDX-FileCopyrightText: 2026 Más Bandwidth LLC
+// SPDX-License-Identifier: MIT
+// THE SME2 STREAMING-SVE VARIANT of the batch kernels (Apple M4/M5 class, arm64 clang).
+//
+// EXPERIMENT (spike-fixed-batch-sme2-streaming-m5). Each kernel is __arm_locally_streaming:
+// ONE smstart sm / smstop sm per CALL, over all n lanes, so the mode switch is amortised
+// over the batch. No ZA is touched (no __arm_new("za")/__arm_inout), so there is no lazy
+// save. The kernels carry a per-function target("sme2") attribute: no global -march flag.
+//
+// THE BIT ARGUMENT. fixMul(a, b) is the low 64 bits of (a*b + 2^15) >> 16 over the exact
+// signed 128-bit product. SVE gives the two halves of that product per 64-bit lane:
+// MUL = low 64 bits, SMULH = high 64 bits (signed). Adding the rounding half to the low
+// half carries into the high half iff the unsigned low sum wrapped (lo2 < lo); then the
+// 128-bit value shifted right by 16 has, as its low 64 bits, (lo2 >> 16) | (hi << 48).
+// fixDot sums three exact products with the same carry-propagating 128-bit add, adds the
+// half once, and shifts once, exactly as fixDot rounds (divide last). Tails are the
+// predicated final iteration of the same loop, so there is no scalar tail.
+#include "fixed/fixed_vec.h"
+
+#if defined( __aarch64__ ) && defined( __clang__ ) && defined( __APPLE__ ) && !defined( FIX_SATURATE ) && \
+	defined( __has_include )
+	#if __has_include( <arm_sme.h> )
+		#include <arm_sme.h>
+
+		#define FIX_ISA_SME2_TARGET __attribute__( ( target( "sme2" ) ) )
+		#define FIX_ISA_SME2_INLINE static inline __attribute__( ( always_inline ) ) FIX_ISA_SME2_TARGET
+
+FIX_ISA_SME2_INLINE svuint64_t fixIsaU( svint64_t v ) __arm_streaming { return svreinterpret_u64_s64( v ); }
+
+// Add a 128-bit (hi:lo) pair into an accumulator pair, carrying from lo into hi.
+FIX_ISA_SME2_INLINE void fixIsaAdd128( svbool_t p, svuint64_t* accLo, svint64_t* accHi, svuint64_t lo, svint64_t hi ) __arm_streaming
+{
+	svuint64_t sum = svadd_u64_x( p, *accLo, lo );
+	svbool_t carry = svcmplt_u64( p, sum, *accLo );
+	*accHi = svadd_s64_x( p, *accHi, hi );
+	*accHi = svadd_n_s64_m( carry, *accHi, 1 );
+	*accLo = sum;
+}
+
+FIX_ISA_SME2_INLINE svint64_t fixIsaShift16( svbool_t p, svuint64_t lo, svint64_t hi ) __arm_streaming
+{
+	return svreinterpret_s64_u64( svorr_u64_x( p, svlsr_n_u64_x( p, lo, 16 ), svlsl_n_u64_x( p, fixIsaU( hi ), 48 ) ) );
+}
+
+FIX_ISA_SME2_TARGET __arm_locally_streaming void fixIsaMulBatchSme2( fixed_t* out, const fixed_t* a, const fixed_t* b, size_t n )
+{
+	const svint64_t half = svdup_n_s64( ( int64_t )FIX_HALF );
+	const uint64_t step = svcntd();
+	for ( uint64_t i = 0; i < n; i += step )
+	{
+		svbool_t p = svwhilelt_b64_u64( i, ( uint64_t )n );
+		svint64_t x = svld1_s64( p, ( const int64_t* )a + i ), y = svld1_s64( p, ( const int64_t* )b + i );
+		svuint64_t lo = svreinterpret_u64_s64( svmul_s64_x( p, x, y ) );
+		svint64_t hi = svmulh_s64_x( p, x, y );
+		svuint64_t sum = svadd_u64_x( p, lo, svreinterpret_u64_s64( half ) );
+		svint64_t accHi = svadd_n_s64_m( svcmplt_u64( p, sum, lo ), hi, 1 );
+		svuint64_t accLo = sum;
+		svst1_s64( p, ( int64_t* )out + i, fixIsaShift16( p, accLo, accHi ) );
+	}
+}
+
+FIX_ISA_SME2_TARGET __arm_locally_streaming void fixIsaDotBatch3Sme2( fixed_t* out, const fixed_t* ax, const fixed_t* ay,
+																	   const fixed_t* az, const fixed_t* bx, const fixed_t* by,
+																	   const fixed_t* bz, size_t n )
+{
+	const svint64_t half = svdup_n_s64( ( int64_t )FIX_HALF );
+	const uint64_t step = svcntd();
+	for ( uint64_t i = 0; i < n; i += step )
+	{
+		svbool_t p = svwhilelt_b64_u64( i, ( uint64_t )n );
+		svint64_t x = svld1_s64( p, ( const int64_t* )ax + i ), u = svld1_s64( p, ( const int64_t* )bx + i );
+		svint64_t y = svld1_s64( p, ( const int64_t* )ay + i ), v = svld1_s64( p, ( const int64_t* )by + i );
+		svint64_t z = svld1_s64( p, ( const int64_t* )az + i ), w = svld1_s64( p, ( const int64_t* )bz + i );
+		svuint64_t accLo = svreinterpret_u64_s64( svmul_s64_x( p, x, u ) );
+		svint64_t accHi = svmulh_s64_x( p, x, u );
+		fixIsaAdd128( p, &accLo, &accHi, svreinterpret_u64_s64( svmul_s64_x( p, y, v ) ), svmulh_s64_x( p, y, v ) );
+		fixIsaAdd128( p, &accLo, &accHi, svreinterpret_u64_s64( svmul_s64_x( p, z, w ) ), svmulh_s64_x( p, z, w ) );
+		fixIsaAdd128( p, &accLo, &accHi, svreinterpret_u64_s64( half ), svdup_n_s64( 0 ) );
+		svst1_s64( p, ( int64_t* )out + i, fixIsaShift16( p, accLo, accHi ) );
+	}
+}
+
+		#define FIX_ISA_SME2_COMPILED 1
+	#endif
+#endif
+
+#ifndef FIX_ISA_SME2_COMPILED
+// Not compiled on this target (or a FIX_SATURATE build). ISO C forbids an empty
+// translation unit.
+typedef int fixIsaSme2NotCompiled;
+#endif
