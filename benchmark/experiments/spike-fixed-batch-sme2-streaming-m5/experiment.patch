diff --git a/benchmark/sme2_batch_bench.c b/benchmark/sme2_batch_bench.c
new file mode 100644
index 0000000..aec164b
--- /dev/null
+++ b/benchmark/sme2_batch_bench.c
@@ -0,0 +1,184 @@
+// SPDX-FileCopyrightText: 2026 Más Bandwidth LLC
+// SPDX-License-Identifier: MIT
+// SME2 STREAMING-SVE BATCH MICROBENCHMARK (spike-fixed-batch-sme2-streaming-m5).
+//
+//   fixed_sme2_batch_bench [repeats] [lanes_per_sample] [consume]
+//
+// consume = 1 makes every call be followed by a non-streaming pass that sums the n output
+// lanes (what benchmark/op_bench.c does and what a real caller does with a result): data
+// stored in streaming mode is then read back by the normal core.
+//
+// For fixMulBatch and fixDotBatch3, at n = 0 (the smstart/smstop cost alone), 1, 8, 16, 32,
+// 64, 128, 256, 512, 1024, 4096: ns per CALL and ns per LANE under three arms measured
+// INTERLEAVED in every repeat: scalar, sme2, and scalar again (the A/A pair, whose gap is
+// the noise floor a claim must beat). The variant is switched with fixForceIsa between
+// samples; each sample is lanes_per_sample / n calls of the same n (iteration counts are
+// arguments; nothing here is a unit test). Then the shared-SME-unit question: T = 1, 2, 4, 6
+// threads each looping fixMulBatch / fixDotBatch3 at n = 1024 and 4096, aggregate lanes per
+// microsecond, scalar against sme2. macOS has no way to pin a thread to a core; the threads
+// are free to land on any core, which is stated in the finding.
+#include "fixed/fixed_isa.h"
+#include "fixed/fixed_vec.h"
+
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+enum { CAP = 4096 };
+static fixed_t in[6][CAP], outv[CAP];
+static volatile uint64_t sink;
+static int consume;
+
+static double nowNs( void )
+{
+	struct timespec ts;
+	clock_gettime( CLOCK_MONOTONIC, &ts );
+	return ( double )ts.tv_sec * 1e9 + ( double )ts.tv_nsec;
+}
+
+static int cmpd( const void* a, const void* b )
+{
+	double x = *( const double* )a, y = *( const double* )b;
+	return ( x > y ) - ( x < y );
+}
+
+static void callOp( int dot, fixed_t* out, size_t n )
+{
+	if ( dot ) fixDotBatch3( out, in[0], in[1], in[2], in[3], in[4], in[5], n );
+	else fixMulBatch( out, in[0], in[1], n );
+}
+
+static double sampleNsPerCall( int dot, size_t n, uint64_t calls )
+{
+	double t0 = nowNs();
+	uint64_t acc = 0;
+	for ( uint64_t c = 0; c < calls; ++c )
+	{
+		callOp( dot, outv, n );
+		if ( consume )
+			for ( size_t i = 0; i < n; ++i ) acc += ( uint64_t )outv[i];
+	}
+	double t1 = nowNs();
+	sink += acc + ( uint64_t )outv[n ? n - 1 : 0];
+	return ( t1 - t0 ) / ( double )calls;
+}
+
+typedef struct Stat { double min, med, max; } Stat;
+static Stat stat( double* v, int n )
+{
+	qsort( v, ( size_t )n, sizeof v[0], cmpd );
+	Stat s = { v[0], v[n / 2], v[n - 1] };
+	return s;
+}
+
+typedef struct Job { int dot; size_t n; uint64_t calls; fixed_t* out; volatile int* go; } Job;
+static void* worker( void* arg )
+{
+	Job* j = ( Job* )arg;
+	while ( !*j->go ) {}
+	for ( uint64_t c = 0; c < j->calls; ++c )
+	{
+		if ( j->dot ) fixDotBatch3( j->out, in[0], in[1], in[2], in[3], in[4], in[5], j->n );
+		else fixMulBatch( j->out, in[0], in[1], j->n );
+	}
+	sink += ( uint64_t )j->out[0];
+	return NULL;
+}
+
+// Aggregate lanes per microsecond with T threads, each doing calls calls of n lanes.
+static double threadedLanesPerUs( int dot, size_t n, int T, uint64_t calls )
+{
+	static fixed_t outs[8][CAP];
+	pthread_t th[8];
+	Job jobs[8];
+	volatile int go = 0;
+	for ( int t = 0; t < T; ++t )
+	{
+		jobs[t] = ( Job ){ dot, n, calls, outs[t], &go };
+		pthread_create( &th[t], NULL, worker, &jobs[t] );
+	}
+	struct timespec nap = { 0, 20 * 1000 * 1000 };
+	nanosleep( &nap, NULL ); // let every thread reach its spin
+	double t0 = nowNs();
+	go = 1;
+	for ( int t = 0; t < T; ++t ) pthread_join( th[t], NULL );
+	double t1 = nowNs();
+	return ( double )( calls * n * ( uint64_t )T ) / ( ( t1 - t0 ) / 1000.0 );
+}
+
+int main( int argc, char** argv )
+{
+	int repeats = argc > 1 ? atoi( argv[1] ) : 9;
+	uint64_t lanes = argc > 2 ? strtoull( argv[2], NULL, 10 ) : UINT64_C( 4000000 );
+	consume = argc > 3 ? atoi( argv[3] ) : 0;
+	if ( repeats < 3 ) repeats = 3;
+	if ( repeats > 64 ) repeats = 64;
+	uint64_t x = UINT64_C( 0x9e3779b97f4a7c15 );
+	for ( int j = 0; j < 6; ++j )
+		for ( int i = 0; i < CAP; ++i )
+		{
+			x ^= x << 13; x ^= x >> 7; x ^= x << 17;
+			in[j][i] = ( fixed_t )x;
+		}
+	if ( fixForceIsa( "sme2" ) != FIX_ISA_OK )
+	{
+		printf( "sme2_batch_bench: sme2 variant unavailable here (compiled=%d)\n", fixIsaCompiled( FIX_ISA_SME2 ) );
+		return 2;
+	}
+	const char* arms[3] = { "scalar", "sme2", "scalar" };
+	const size_t ns[] = { 0, 1, 8, 16, 32, 64, 128, 256, 512, 1024, 4096 };
+	printf( "# repeats=%d lanes_per_sample=%llu consume=%d; arms interleaved scalar,sme2,scalar(A/A) each repeat\n", repeats,
+			( unsigned long long )lanes, consume );
+	printf( "op,n,scalar_ns_call_min,scalar_ns_call_med,scalar_spread_pct,sme2_ns_call_min,sme2_ns_call_med,sme2_spread_pct,"
+			"scalar2_ns_call_med,AA_gap_pct,scalar_ns_lane_med,sme2_ns_lane_med,speedup_med\n" );
+	for ( int dot = 0; dot < 2; ++dot )
+	{
+		for ( size_t k = 0; k < sizeof ns / sizeof ns[0]; ++k )
+		{
+			const size_t n = ns[k];
+			const uint64_t calls = n ? ( lanes / n > 0 ? lanes / n : 1 ) : UINT64_C( 2000000 );
+			double v[3][64];
+			for ( int arm = 0; arm < 3; ++arm ) { fixForceIsa( arms[arm] ); ( void )sampleNsPerCall( dot, n, calls / 10 + 1 ); }
+			for ( int r = 0; r < repeats; ++r )
+				for ( int arm = 0; arm < 3; ++arm )
+				{
+					fixForceIsa( arms[arm] );
+					v[arm][r] = sampleNsPerCall( dot, n, calls );
+				}
+			Stat a = stat( v[0], repeats ), b = stat( v[1], repeats ), c = stat( v[2], repeats );
+			double lane = n ? ( double )n : 1.0;
+			printf( "%s,%zu,%.3f,%.3f,%.1f,%.3f,%.3f,%.1f,%.3f,%.1f,%.4f,%.4f,%.3f\n", dot ? "fixDotBatch3" : "fixMulBatch", n,
+					a.min, a.med, 100.0 * ( a.max - a.min ) / a.med, b.min, b.med, 100.0 * ( b.max - b.min ) / b.med, c.med,
+					100.0 * ( c.med > a.med ? c.med - a.med : a.med - c.med ) / a.med, a.med / lane, b.med / lane, a.med / b.med );
+			fflush( stdout );
+		}
+	}
+	printf( "# threads: aggregate lanes per microsecond (higher is faster), median of %d, scalar vs sme2\n", repeats );
+	printf( "op,n,threads,scalar_lanes_us_med,sme2_lanes_us_med,speedup_med,scalar_spread_pct,sme2_spread_pct\n" );
+	const int tcounts[] = { 1, 2, 4, 6 };
+	for ( int dot = 0; dot < 2; ++dot )
+		for ( int nn = 0; nn < 2; ++nn )
+		{
+			const size_t n = nn ? 4096 : 1024;
+			for ( size_t ti = 0; ti < sizeof tcounts / sizeof tcounts[0]; ++ti )
+			{
+				const int T = tcounts[ti];
+				const uint64_t calls = lanes * 4 / n;
+				double v[2][64];
+				for ( int r = 0; r < repeats; ++r )
+					for ( int arm = 0; arm < 2; ++arm )
+					{
+						fixForceIsa( arm ? "sme2" : "scalar" );
+						v[arm][r] = threadedLanesPerUs( dot, n, T, calls );
+					}
+				Stat a = stat( v[0], repeats ), b = stat( v[1], repeats );
+				printf( "%s,%zu,%d,%.2f,%.2f,%.3f,%.1f,%.1f\n", dot ? "fixDotBatch3" : "fixMulBatch", n, T, a.med, b.med,
+						b.med / a.med, 100.0 * ( a.max - a.min ) / a.med, 100.0 * ( b.max - b.min ) / b.med );
+				fflush( stdout );
+			}
+		}
+	return 0;
+}
