+/// Leading-zero count for a 64-bit lane, written out rather than taken from a builtin so
+/// the plain-MSVC arm needs no intrinsic and every arm folds the same way. (Same shape as
+/// fixCountLeadingZeros64 in fixed_int256.h, kept local so this header stays self-contained.)
+FIX_ALWAYS_INLINE int fixEmuCountLeadingZeros64( uint64_t x )
+{
+#if defined( __aarch64__ ) && defined( __GNUC__ )
+	// One CLZ instruction; x == 0 is defined here (64) exactly as in the portable ladder.
+	return x == 0 ? 64 : __builtin_clzll( x );
+#else
+	if ( x == 0 )
+	{
+		return 64;
+	}
+	int n = 0;
+	if ( ( x >> 32 ) == 0 ) { n += 32; x <<= 32; }
+	if ( ( x >> 48 ) == 0 ) { n += 16; x <<= 16; }
+	if ( ( x >> 56 ) == 0 ) { n += 8; x <<= 8; }
+	if ( ( x >> 60 ) == 0 ) { n += 4; x <<= 4; }
+	if ( ( x >> 62 ) == 0 ) { n += 2; x <<= 2; }
+	if ( ( x >> 63 ) == 0 ) { n += 1; }
+	return n;
+#endif
+}
+
+/// ( r * (fhi*2^64 + flo) ) >> 127, exact. r, fhi and flo are 64-bit; the full product is
+/// 192 bits and only its top 65 bits survive the shift, assembled from the two 64x64->128
+/// products without forming the middle bits that the shift discards anyway.
+FIX_ALWAYS_INLINE uint64_t fixEmuMulHi127( uint64_t r, uint64_t fhi, uint64_t flo )
+{
+	fixEmuUInt128 a = fixEmuUInt128MulU64( r, fhi );
+	fixEmuUInt128 b = fixEmuUInt128MulU64( r, flo );
+	uint64_t v1 = a.lo + b.hi;
+	uint64_t carry = ( v1 < a.lo ) ? 1 : 0;
+	uint64_t v2 = a.hi + carry;
+	return ( v2 << 1 ) + ( v1 >> 63 );
+}
+
+/// Exact 128/64 division with a 64-bit quotient, via a table-free Newton-Raphson reciprocal.
+///
+/// PRECONDITION: hi < d and d != 0, so q = floor( (hi*2^64 + lo) / d ) fits in 64 bits --
+/// the same invariant fixUInt128DivRemBy64 documents. The divisor is normalized so its top
+/// bit is set, a 64-bit reciprocal of 2^127 / d is seeded from one hardware double division
+/// and refined by three integer Newton steps, the quotient estimate is the top 65 bits of the
+/// product, and an EXACT remainder compare drives it to the true truncating quotient. The
+/// double is only a seed (as in fixSqrt): the final quotient and remainder are exact integer
+/// results and cannot differ from any other correct algorithm, so determinism is preserved.
+FIX_ALWAYS_INLINE uint64_t fixEmuUInt128DivRemBy64Recip( uint64_t hi, uint64_t lo, uint64_t d, uint64_t* remainder )
+{
+	int s = fixEmuCountLeadingZeros64( d );
+	uint64_t dn = d << s;
+	uint64_t nhi = ( s == 0 ) ? hi : ( hi << s ) | ( lo >> ( 64 - s ) );
+	uint64_t nlo = ( s == 0 ) ? lo : ( lo << s );
+
+	// 2^127 / dn as a double, then the nearest 64-bit integer below 2^64.
+	double r0 = 1.70141183460469231731687303715884105728e38 / (double)dn;
+	uint64_t r = ( r0 >= 1.8446744073709551616e19 ) ? UINT64_C( 0xFFFFFFFFFFFFFFFF ) : (uint64_t)r0;
+
+	// Newton-Raphson for r ~ 2^127/dn: r_{k+1} = r_k * (2^128 - dn * r_k) / 2^127.
+	for ( int it = 0; it < 3; ++it )
+	{
+		fixEmuUInt128 p = fixEmuUInt128MulU64( dn, r ); // dn * r < 2^128
+		fixEmuUInt128 f = fixEmuUInt128Add( fixEmuUInt128Not( p ), fixEmuUInt128FromU64( 1 ) ); // 2^128 - p
+		r = fixEmuMulHi127( r, f.hi, f.lo );
+	}
+
+	uint64_t q = fixEmuMulHi127( r, nhi, nlo );
+
+	// Exact repair: walk q to the unique quotient. r < d and q*d <= n, then bump.
+	fixEmuUInt128 n = fixEmuUInt128Make( hi, lo );
+	fixEmuUInt128 qd = fixEmuUInt128MulU64( q, d );
+	while ( fixEmuUInt128Gt( qd, n ) ) { --q; qd = fixEmuUInt128Sub( qd, fixEmuUInt128FromU64( d ) ); }
