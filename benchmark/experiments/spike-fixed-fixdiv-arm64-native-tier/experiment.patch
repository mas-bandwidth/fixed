diff --git a/test/fixdiv_arm64_native_tier_test.c b/test/fixdiv_arm64_native_tier_test.c
new file mode 100644
index 0000000..f3fcb05
--- /dev/null
+++ b/test/fixdiv_arm64_native_tier_test.c
@@ -0,0 +1,196 @@
+// SPDX-FileCopyrightText: 2026 Más Bandwidth LLC
+// SPDX-License-Identifier: MIT
+// FixDivArm64NativeTierEquivalenceTest: fixInt128Div and fixDiv held to an exact reference.
+//
+// On native aarch64 fixInt128Div sends a non-zero divisor that fits in 64 bits through the
+// reciprocal-plus-exact-repair routine instead of the __divti3 libcall
+// (FIX_INT128_DIV_NATIVE_RECIP_TIER). This test is the equivalence of that tier against
+// two independent references, and it runs in every build arm (native, emulated, saturated)
+// on every host, so the same lanes are checked wherever the code is compiled:
+//
+//   1. an independent restoring shift-subtract on uint64 pairs (no __int128 at all), on the
+//      structured edge grid crossed with itself and on a seeded sample; and
+//   2. where the compiler has __int128, its own division (the libcall the tier replaces),
+//      forced out of line, on the grid and on N seeded full-width lanes (the count is the
+//      first argument; 100 million by default).
+//
+// A COUNTER, NEVER A CLOCK. The tier's reach is counted: the number of lanes whose divisor
+// is non-zero and below 2^64 must be non-zero on every build, so a sweep whose lanes all
+// bypassed the tier cannot pass. A deliberately wrong reference (one added to the quotient)
+// must be detected at least once: a comparison that never saw a difference compared nothing.
+#include "fixed/fixed.h"
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#ifndef FIX_INT128_DIV_NATIVE_RECIP_TIER
+	#error "FIX_INT128_DIV_NATIVE_RECIP_TIER is not defined: the native arm64 division tier is absent from this tree"
+#endif
+
+#if defined( __GNUC__ )
+	#define REF_NOINLINE __attribute__( ( noinline ) )
+#else
+	#define REF_NOINLINE
+#endif
+
+typedef struct { uint64_t hi, lo; } P128;
+
+static uint64_t rngState;
+static uint64_t rngNext( void )
+{
+	uint64_t z = ( rngState += UINT64_C( 0x9E3779B97F4A7C15 ) );
+	z = ( z ^ ( z >> 30 ) ) * UINT64_C( 0xBF58476D1CE4E5B9 );
+	z = ( z ^ ( z >> 27 ) ) * UINT64_C( 0x94D049BB133111EB );
+	return z ^ ( z >> 31 );
+}
+
+// ---- reference 1: restoring shift-subtract on uint64 pairs, signed by magnitude. ----
+static int ge( P128 a, P128 b ) { return a.hi != b.hi ? a.hi > b.hi : a.lo >= b.lo; }
+static P128 sub( P128 a, P128 b ) { P128 r; r.lo = a.lo - b.lo; r.hi = a.hi - b.hi - ( a.lo < b.lo ); return r; }
+static P128 neg( P128 a ) { P128 r; r.lo = ~a.lo + 1; r.hi = ~a.hi + ( r.lo == 0 ); return r; }
+static int isNeg( P128 a ) { return ( a.hi >> 63 ) != 0; }
+static P128 refDivSS( P128 a, P128 b )
+{
+	int sa = isNeg( a ), sb = isNeg( b );
+	P128 n = sa ? neg( a ) : a, d = sb ? neg( b ) : b, q = { 0, 0 }, r = { 0, 0 };
+	if ( d.hi == 0 && d.lo == 0 ) { return q; }
+	for ( int i = 127; i >= 0; i-- )
+	{
+		r.hi = ( r.hi << 1 ) | ( r.lo >> 63 );
+		r.lo = ( r.lo << 1 ) | ( ( i >= 64 ? n.hi >> ( i - 64 ) : n.lo >> i ) & 1 );
+		if ( ge( r, d ) )
+		{
+			r = sub( r, d );
+			if ( i >= 64 ) q.hi |= UINT64_C( 1 ) << ( i - 64 ); else q.lo |= UINT64_C( 1 ) << i;
+		}
+	}
+	return ( sa != sb ) ? neg( q ) : q;
+}
+
+static fixInt128 toFix( P128 p ) { return fixInt128Make( p.hi, p.lo ); }
+static P128 fromFix( fixInt128 v ) { P128 p; p.hi = fixInt128Hi( v ); p.lo = fixInt128Lo( v ); return p; }
+static int eq( P128 a, P128 b ) { return a.hi == b.hi && a.lo == b.lo; }
+
+#if defined( __SIZEOF_INT128__ )
+	#define HAS_NATIVE 1
+__extension__ typedef __int128 nativeI128;
+// Out of line so the reference division is the real libcall and cannot fold against the
+// inlined candidate.
+static REF_NOINLINE P128 refDivNative( P128 a, P128 b )
+{
+	nativeI128 x = (nativeI128)( ( (unsigned __int128)a.hi << 64 ) | a.lo );
+	nativeI128 y = (nativeI128)( ( (unsigned __int128)b.hi << 64 ) | b.lo );
+	nativeI128 q = x / y;
+	P128 r; r.hi = (uint64_t)( (unsigned __int128)q >> 64 ); r.lo = (uint64_t)q; return r;
+}
+#else
+	#define HAS_NATIVE 0
+#endif
+
+static uint64_t failures, checked, tierLanes, perturbedSeen;
+
+static void checkLane( P128 a, P128 b, int withSS )
+{
+	if ( b.hi == 0 && b.lo == 0 ) { return; } // division by zero is not compared (native arms disagree)
+	P128 got = fromFix( fixInt128Div( toFix( a ), toFix( b ) ) );
+	int bFits = isNeg( b ) ? ( b.hi == UINT64_MAX ) : ( b.hi == 0 );
+	if ( bFits ) { tierLanes++; }
+	checked++;
+	int bad = 0;
+#if HAS_NATIVE
+	P128 want = refDivNative( a, b );
+	if ( !eq( got, want ) ) { bad = 1; }
+	P128 wrong = want; wrong.lo += 1;
+	if ( !eq( got, wrong ) ) { perturbedSeen++; }
+#endif
+	if ( withSS && !eq( got, refDivSS( a, b ) ) ) { bad = 1; }
+	if ( bad && failures++ < 8 )
+	{
+		printf( "MISMATCH a=%016" PRIx64 "%016" PRIx64 " b=%016" PRIx64 "%016" PRIx64 " got=%016" PRIx64 "%016" PRIx64 "\n",
+				a.hi, a.lo, b.hi, b.lo, got.hi, got.lo );
+	}
+}
+
+static void grid( P128* out, int* n )
+{
+	int c = 0;
+	P128 base[] = { { 0, 0 }, { 0, 1 }, { 0, 2 }, { 0, 3 }, { 0, UINT64_MAX }, { 0, UINT64_MAX - 1 }, { 1, 0 }, { 1, 1 }, { 1, UINT64_MAX },
+					{ UINT64_MAX, UINT64_MAX }, { UINT64_MAX, 0 }, { UINT64_MAX, UINT64_MAX - 1 }, { UINT64_C( 0x7FFFFFFFFFFFFFFF ), UINT64_MAX },
+					{ UINT64_C( 0x8000000000000000 ), 0 }, { UINT64_C( 0x8000000000000000 ), 1 }, { 0, UINT64_C( 0x8000000000000000 ) },
+					{ 0, UINT64_C( 0x7FFFFFFFFFFFFFFF ) }, { 0, UINT64_C( 0x8000000000000001 ) }, { 0xFFFFFFFF, 0xFFFFFFFF00000000 } };
+	for ( size_t i = 0; i < sizeof base / sizeof base[0]; i++ ) { out[c++] = base[i]; }
+	for ( int k = 1; k < 128; k++ )
+	{
+		for ( int dlt = -1; dlt <= 1; dlt++ )
+		{
+			P128 v = { 0, 0 };
+			if ( k >= 64 ) { v.hi = UINT64_C( 1 ) << ( k - 64 ); } else { v.lo = UINT64_C( 1 ) << k; }
+			if ( dlt == -1 ) { v = sub( v, ( P128 ){ 0, 1 } ); }
+			if ( dlt == 1 ) { v.lo += 1; }
+			out[c++] = v;
+			out[c++] = neg( v );
+		}
+	}
+	*n = c;
+}
+
+int main( int argc, char** argv )
+{
+	uint64_t lanes = 100000000ULL;
+	if ( argc > 1 ) { lanes = strtoull( argv[1], NULL, 10 ); }
+
+	// THE GRID crossed with itself, against both references.
+	static P128 g[1024];
+	int gn = 0;
+	grid( g, &gn );
+	for ( int i = 0; i < gn; i++ ) { for ( int j = 0; j < gn; j++ ) { checkLane( g[i], g[j], 1 ); } }
+	printf( "grid %d x %d lanes\n", gn, gn );
+
+	// fixDiv shape: numerator magnitude >= 2^47 (the slow tier), any 64-bit divisor, against
+	// the shift-subtract reference through the public fixDiv.
+	rngState = UINT64_C( 0xF1D1F1D1 );
+	for ( int i = 0; i < 200000; i++ )
+	{
+		int64_t a = (int64_t)( rngNext() >> ( rngNext() % 17 ) );
+		if ( a > -( (int64_t)1 << 47 ) && a < ( (int64_t)1 << 47 ) ) { a += ( a < 0 ? -1 : 1 ) * ( (int64_t)1 << 47 ); }
+		int64_t b = (int64_t)( rngNext() >> ( rngNext() % 63 ) );
+		if ( b == 0 ) { continue; }
+		P128 n = { (uint64_t)( a >> ( 64 - FIX_FRACTION_BITS ) ), (uint64_t)a << FIX_FRACTION_BITS }; // a << 16 as a signed 128
+		P128 d = { b < 0 ? UINT64_MAX : 0, (uint64_t)b };
+		P128 q = refDivSS( n, d );
+		fixed_t want;
+		if ( ( q.hi == 0 && q.lo > (uint64_t)INT64_MAX ) || ( q.hi != 0 && !( q.hi == UINT64_MAX && q.lo >= UINT64_C( 0x8000000000000001 ) ) ) )
+		{
+			want = isNeg( q ) ? FIX_MIN : FIX_MAX;
+		}
+		else { want = (fixed_t)q.lo; }
+		if ( fixDiv( a, b ) != want && failures++ < 8 ) { printf( "fixDiv MISMATCH a=%" PRId64 " b=%" PRId64 "\n", a, b ); }
+		checked++;
+	}
+
+	// SEEDED FULL-WIDTH LANES: random 128-bit dividend, divisor of random bit width 1..128,
+	// every sign combination falls out of the random words. The shift-subtract reference
+	// joins on every 100th lane (it is 128 iterations) and the libcall on all of them.
+	rngState = UINT64_C( 0x5EED1234ABCD0001 );
+	for ( uint64_t i = 0; i < lanes; i++ )
+	{
+		P128 a = { rngNext(), rngNext() };
+		int sh = (int)( rngNext() % 4 );
+		if ( sh == 1 ) { a.hi >>= rngNext() % 64; } else if ( sh == 2 ) { a.hi = 0; a.lo >>= rngNext() % 64; } else if ( sh == 3 ) { a.hi = (uint64_t)-( (int64_t)( rngNext() & 0xFF ) ); }
+		P128 b = { rngNext(), rngNext() };
+		int w = (int)( rngNext() % 128 ) + 1;
+		if ( w <= 64 ) { b.hi = 0; b.lo = w == 64 ? b.lo : b.lo & ( ( UINT64_C( 1 ) << w ) - 1 ); } else { b.hi = b.hi & ( ( UINT64_C( 1 ) << ( w - 64 ) ) - 1 ); if ( w == 128 ) { b.hi = rngNext(); } }
+		if ( rngNext() & 1 ) { b = neg( b ); }
+		checkLane( a, b, ( i % 100 ) == 0 );
+	}
+
+	printf( "checked %" PRIu64 " lanes, %" PRIu64 " through the 64-bit-divisor tier, %" PRIu64 " mismatches\n", checked, tierLanes, failures );
+	if ( tierLanes == 0 ) { printf( "FAIL: no lane reached the 64-bit-divisor tier\n" ); return 1; }
+#if HAS_NATIVE
+	if ( perturbedSeen == 0 ) { printf( "FAIL: the perturbed reference was never detected\n" ); return 1; }
+#endif
+	if ( failures != 0 ) { printf( "FAIL\n" ); return 1; }
+	printf( "PASS FixDivArm64NativeTierEquivalenceTest (tier=%d, native_ref=%d)\n", FIX_INT128_DIV_NATIVE_RECIP_TIER, HAS_NATIVE );
+	return 0;
+}
