+// Exact reciprocal of a 64-bit divisor in [1, 2^47): R = floor(2^64 / d). The one
+// divide on the normalization hot path; the three per-component quotients are then
+// formed by multiplication and corrected exactly (see fixNormalizeComponentByRecip).
+FIX_INLINE uint64_t fixReciprocal64( uint64_t d )
+{
+	uint64_t ignored;
+	return fixUInt128DivRemBy64( fixUInt128Make( 1, 0 ), d, &ignored );
+}
+
+// trunc(component * 2^16 / d), computed from the precomputed R = floor(2^64/d) instead
+// of a hardware divide. R underestimates the true quotient by at most one for every
+// component magnitude below 2^48, and the remainder test below repairs that exactly, so
+// the result is bit-identical to fixDiv's truncation for every such input.
+FIX_INLINE fixed_t fixNormalizeComponentByRecip( fixed_t component, uint64_t d, uint64_t r )
+{
+	uint64_t mag = component < 0 ? (uint64_t)( -( component + 1 ) ) + 1 : (uint64_t)component;
+	uint64_t n = mag << FIX_FRACTION_BITS;
+	uint64_t q = fixUInt128Hi( fixUInt128MulU64( n, r ) );
+	uint64_t rem = n - q * d;
+	if ( rem >= d )
+	{
+		++q;
+	}
+	return component < 0 ? -(int64_t)q : (int64_t)q;
+}
+
+// The three divides of fixNormalizeWithLength's lifted path, folded into one reciprocal
+// and three multiply-and-correct quotients. The lifted components are below 2^46, well
+// inside the 2^48 precondition of fixNormalizeComponentByRecip.
+FIX_INLINE fixVec3 fixNormalizeThreeByRecip( fixVec3 a, uint64_t length )
+{
+	uint64_t r = fixReciprocal64( length );
+	return FIX_LITERAL( fixVec3 ){ fixNormalizeComponentByRecip( a.x, length, r ),
+		fixNormalizeComponentByRecip( a.y, length, r ), fixNormalizeComponentByRecip( a.z, length, r ) };
+}
+
+// The four divides of fixNormalizeQuat's near-unit path, folded into one reciprocal.
+FIX_INLINE fixQuat fixNormalizeQuatByRecip( fixQuat q, uint64_t length )
+{
+	uint64_t r = fixReciprocal64( length );
+	return FIX_LITERAL( fixQuat ){ { fixNormalizeComponentByRecip( q.v.x, length, r ),
+		fixNormalizeComponentByRecip( q.v.y, length, r ), fixNormalizeComponentByRecip( q.v.z, length, r ) },
+		fixNormalizeComponentByRecip( q.s, length, r ) };
+}
