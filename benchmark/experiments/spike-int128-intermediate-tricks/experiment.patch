+// ================================================================================
+// Int128SeamTricksEquivalenceTest: the shift-free-rounding fixMul candidate held to the
+// plain __int128 reference. The structured edge grid crosses itself, then a seeded
+// random sample of full int64 pairs (negative operands included: round-half-up is not
+// odd-symmetric, so -(a*b) rounding cannot be inferred from (a*b) rounding). The
+// perturbed arms add `perturb` to the candidate's result, so the comparison is provably
+// live (a blind loop would find zero mismatches and fail).
+// ================================================================================
+
+static uint64_t sweepMulRoundFast( int perturb, uint64_t samples )
+{
+	uint64_t bad = 0;
+
+	// The edge grid as raw bits so that -2^k never forms a signed-overflow value: negating
+	// a 64-bit unsigned lane is exactly the two's-complement edge it names.
+	uint64_t edges[ 4 * 64 + 8 ];
+	int n = 0;
+	edges[n++] = 0;                            // 0
+	edges[n++] = 1;                            // +1
+	edges[n++] = 0xFFFFFFFFFFFFFFFFULL;        // -1
+	edges[n++] = 0x8000000000000000ULL;        // INT64_MIN
+	edges[n++] = 0x7FFFFFFFFFFFFFFFULL;        // INT64_MAX
+	edges[n++] = 0x8000000000000001ULL;        // -INT64_MAX (FIX_MIN)
+	for ( int k = 0; k < 63; k++ )
+	{
+		uint64_t p = 1ULL << k;                // 2^k
+		edges[n++] = p;                        // +2^k
+		edges[n++] = 0ULL - p;                 // -(2^k)
+		edges[n++] = p - 1;                    // +(2^k - 1)
+		edges[n++] = 0ULL - ( p - 1 );         // -(2^k - 1)
+	}
+	// k == 63: 2^63 is INT64_MIN and 2^63 - 1 is INT64_MAX, both already in the grid.
+
+	for ( int ai = 0; ai < n; ai++ )
+	{
+		for ( int bi = 0; bi < n; bi++ )
+		{
+			int64_t a = (int64_t)edges[ai];
+			int64_t b = (int64_t)edges[bi];
+			int64_t got = (int64_t)( (uint64_t)fixMul( a, b ) + (uint64_t)perturb );
+#if HAS_NATIVE
+			bad += ( got == refMulRound( a, b ) ) ? 0 : 1;
+#else
+			(void)got;
+#endif
+		}
+	}
+
+	rngState = 0xB7000000ULL + (uint64_t)perturb;
+	for ( uint64_t i = 0; i < samples; i++ )
+	{
+		int64_t a = (int64_t)nextRandom();
+		int64_t b = (int64_t)nextRandom();
+		int64_t got = (int64_t)( (uint64_t)fixMul( a, b ) + (uint64_t)perturb );
+#if HAS_NATIVE
+		bad += ( got == refMulRound( a, b ) ) ? 0 : 1;
+#else
+		(void)got;
+#endif
+	}
+
+	return bad;
+}
+
 // ================================================================================
 
 typedef uint64_t ( *SweepFcn )( int perturb, uint64_t samples );
