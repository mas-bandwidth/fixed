+// The plain __int128 spelling of fixMul's rounding, forced out of line so the optimizer
+// cannot fold it into the candidate it is checking. This is the reference the
+// Int128SeamTricksEquivalenceTest holds the shift-free-rounding candidate to: widen,
+// add half, shift out the fraction bits, narrow. No saturation, exactly like the
+// default (FIX_SATURATE-undefined) fixMul the spike measures.
+static REF_NOINLINE int64_t refMulRound( int64_t a, int64_t b )
+{
+	return (int64_t)( ( (nativeInt128)a * b + (nativeInt128)FIX_HALF ) >> FIX_FRACTION_BITS );
+}
