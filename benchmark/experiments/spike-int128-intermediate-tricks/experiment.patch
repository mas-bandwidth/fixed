diff --git a/include/fixed/fixed.h b/include/fixed/fixed.h
index a76db23..34fa8e0 100644
--- a/include/fixed/fixed.h
+++ b/include/fixed/fixed.h
@@ -199,13 +199,19 @@ FIX_ALWAYS_INLINE fixInt128 fixInt128Div( fixInt128 a, fixInt128 b )
 /// on, and duplicating it would buy nothing.
 FIX_ALWAYS_INLINE fixed_t fixMul( fixed_t a, fixed_t b )
 {
-	// Round half up, then shift out the fraction bits (arithmetic shift)
+	// Round half up, then shift out the fraction bits (arithmetic shift).
+	//
+	// SPIKE (int128-intermediate-tricks, candidate (a)): instead of a 128-bit add of the
+	// rounding half followed by a 128-bit arithmetic shift, widen once, add the half to
+	// the low lane with an explicit carry into the high lane, and assemble the shifted
+	// result from the two lanes: (hi << 48) | (lo >> 16). This is bit-identical to the
+	// reference because the low 64 bits of (product + HALF) >> 16 are bits [16, 80) of
+	// (product + HALF), which is exactly (hi << 48) | (lo >> 16) under two's complement.
+	// On x86-64 the compiler already emits this shape (imulq; addq $32768; adcq $0; shrdq
+	// $16) for the ORIGINAL spelling, so the rewrite is a transcription, not a speedup.
 #if FIX_INT128_EMULATED
 	fixInt128 product = fixInt128MulI64( a, b );
 	fixInt128 r = fixInt128Shr( fixInt128Add( product, fixInt128FromI64( FIX_HALF ) ), FIX_FRACTION_BITS );
-#else
-	fixInt128 r = (fixInt128)( (fixUInt128)( (fixInt128)a * b ) + (fixUInt128)(fixInt128)FIX_HALF ) >> FIX_FRACTION_BITS;
-#endif
 #if defined( FIX_SATURATE )
 	if ( fixInt128Gt( r, fixInt128FromI64( INT64_MAX ) ) )
 	{
@@ -217,6 +223,27 @@ FIX_ALWAYS_INLINE fixed_t fixMul( fixed_t a, fixed_t b )
 	}
 #endif
 	return (fixed_t)fixInt128ToI64( r );
+#else
+	fixUInt128 product = (fixUInt128)( (fixInt128)a * b );
+	uint64_t lo = (uint64_t)product;
+	uint64_t hi = (uint64_t)( product >> 64 );
+	uint64_t rlo = lo + (uint64_t)FIX_HALF;
+	uint64_t rhi = hi + ( rlo < lo ? 1 : 0 );
+#if defined( FIX_SATURATE )
+	fixInt128 r = (fixInt128)( ( (fixUInt128)rhi << 64 ) | (fixUInt128)rlo ) >> FIX_FRACTION_BITS;
+	if ( fixInt128Gt( r, fixInt128FromI64( INT64_MAX ) ) )
+	{
+		return FIX_MAX;
+	}
+	if ( fixInt128Lt( r, fixInt128FromI64( -INT64_MAX ) ) )
+	{
+		return FIX_MIN;
+	}
+	return (fixed_t)fixInt128ToI64( r );
+#else
+	return (fixed_t)( ( rhi << 48 ) | ( rlo >> 16 ) );
+#endif
+#endif
 }
 
