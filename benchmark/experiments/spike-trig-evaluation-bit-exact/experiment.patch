diff --git a/test/trig_evaluation_exhaustive_test.c b/test/trig_evaluation_exhaustive_test.c
new file mode 100644
index 0000000..ea796fa
--- /dev/null
+++ b/test/trig_evaluation_exhaustive_test.c
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: MIT
+// Bit-exactness guard for the trig-evaluation spike. The OLD fixComputeCosSin and
+// fixAtan2 bodies are copied here verbatim as the reference; the library's (candidate)
+// implementations must produce the SAME output bits for every input in the exhaustive
+// grids below. No clock, no files, no network.
+#include "fixed/fixed_math.h"
+#include <stdint.h>
+#include <stdio.h>
+
+// ---- reference helpers (copied from the baseline src/fixed_math.c) ----
+static inline int64_t refQ32Mul( int64_t a, int64_t b )
+{
+	return fixInt128ToI64( fixInt128Shr( fixInt128MulI64( a, b ), 32 ) );
+}
+
+static inline int64_t refQ32Div( int64_t a, int64_t b )
+{
+	return fixInt128ToI64( fixInt128Div( fixInt128ShiftLeft( fixInt128FromI64( a ), 32 ), fixInt128FromI64( b ) ) );
+}
+
+static inline int64_t refQ32Sqrt( int64_t a )
+{
+	if ( a <= 0 )
+	{
+		return 0;
+	}
+	uint64_t hi = (uint64_t)a >> 32;
+	uint64_t lo = (uint64_t)a << 32;
+	return (int64_t)fixISqrt128High( hi, lo );
+}
+
+static inline fixed_t refQ32ToFix( int64_t a )
+{
+	return ( a + ( (int64_t)1 << 15 ) ) >> 16;
+}
+
+#define REF_Q32_PI 13493037705LL
+#define REF_Q32_HALF_PI 6746518852LL
+
+static fixed_t refAtan2( fixed_t y, fixed_t x )
+{
+	if ( x == 0 && y == 0 )
+	{
+		return 0;
+	}
+
+	fixed_t ax = fixAbs( x );
+	fixed_t ay = fixAbs( y );
+	fixed_t mx = fixMax( ay, ax );
+	fixed_t mn = fixMin( ay, ax );
+
+	int64_t a = refQ32Div( mn, mx );
+
+	int64_t s = refQ32Mul( a, a );
+	int64_t c = refQ32Mul( s, a );
+	int64_t q = refQ32Mul( s, s );
+	int64_t r = refQ32Mul( 106688212LL, q ) + 802360794LL;
+	int64_t t = refQ32Mul( -404147609LL, q ) - 1426490580LL;
+	r = refQ32Mul( r, s ) + t;
+	r = refQ32Mul( r, c ) + a;
+
+	if ( ay > ax )
+	{
+		r = REF_Q32_HALF_PI - r;
+	}
+
+	if ( x < 0 )
+	{
+		r = REF_Q32_PI - r;
+	}
+
+	if ( y < 0 )
+	{
+		r = -r;
+	}
+
+	return refQ32ToFix( r );
+}
+
+static fixCosSin refComputeCosSin( fixed_t radians )
+{
+	const int64_t pi = REF_Q32_PI;
+	const int64_t halfPi = REF_Q32_HALF_PI;
+	const int64_t pi2 = 42389628127LL;
+	const int64_t fivePi2 = 211948140636LL;
+
+	int64_t x = fixShiftLeft( fixUnwindAngle( radians ), 16 );
+	x = x < -pi ? -pi : ( x > pi ? pi : x );
+
+	int64_t c;
+	if ( x < -halfPi )
+	{
+		int64_t y = x + pi;
+		int64_t y2 = refQ32Mul( y, y );
+		c = -refQ32Div( pi2 - 4 * y2, pi2 + y2 );
+	}
+	else if ( x > halfPi )
+	{
+		int64_t y = x - pi;
+		int64_t y2 = refQ32Mul( y, y );
+		c = -refQ32Div( pi2 - 4 * y2, pi2 + y2 );
+	}
+	else
+	{
+		int64_t y2 = refQ32Mul( x, x );
+		c = refQ32Div( pi2 - 4 * y2, pi2 + y2 );
+	}
+
+	int64_t s;
+	if ( x < 0 )
+	{
+		int64_t y = x + pi;
+		int64_t u = refQ32Mul( y, pi - y );
+		s = -refQ32Div( 16 * u, fivePi2 - 4 * u );
+	}
+	else
+	{
+		int64_t u = refQ32Mul( x, pi - x );
+		s = refQ32Div( 16 * u, fivePi2 - 4 * u );
+	}
+
+	int64_t mag = refQ32Sqrt( refQ32Mul( s, s ) + refQ32Mul( c, c ) );
+	if ( mag > 0 )
+	{
+		c = refQ32Div( c, mag );
+		s = refQ32Div( s, mag );
+	}
+
+	fixCosSin cs = { refQ32ToFix( c ), refQ32ToFix( s ) };
+	return cs;
+}
+
+static int fails = 0;
+#define CHECK( cond ) \
+	do { if ( !( cond ) ) { printf( "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond ); fails++; } } while ( 0 )
+
+int main( void )
+{
+	// cos/sin over every raw angle in [-4 pi, 4 pi] at full Q48.16 resolution.
+	{
+		fixed_t lo = fixFromDouble( -4.0 * 3.14159265358979323846 );
+		fixed_t hi = fixFromDouble( 4.0 * 3.14159265358979323846 );
+		long long count = 0;
+		for ( fixed_t a = lo; a <= hi; a++ )
+		{
+			fixCosSin got = fixComputeCosSin( a );
+			fixCosSin ref = refComputeCosSin( a );
+			if ( got.cosine != ref.cosine || got.sine != ref.sine )
+			{
+				printf( "cos/sin mismatch at angle %lld: got (%lld,%lld) ref (%lld,%lld)\n",
+						(long long)a, (long long)got.cosine, (long long)got.sine,
+						(long long)ref.cosine, (long long)ref.sine );
+				fails++;
+				break;
+			}
+			count++;
+		}
+		printf( "cos/sin exhaustive: %lld angles checked\n", count );
+		CHECK( count > 1600000 );
+	}
+
+	// atan2 over a 4096 x 4096 grid of (y, x) crossed with sign and the axes.
+	{
+		long long count = 0;
+		for ( int i = -2048; i <= 2048; i++ )
+		{
+			for ( int j = -2048; j <= 2048; j++ )
+			{
+				fixed_t y = (fixed_t)i * 16;
+				fixed_t x = (fixed_t)j * 16;
+				fixed_t got = fixAtan2( y, x );
+				fixed_t ref = refAtan2( y, x );
+				if ( got != ref )
+				{
+					printf( "atan2 mismatch at (%lld,%lld): got %lld ref %lld\n",
+							(long long)y, (long long)x, (long long)got, (long long)ref );
+					fails++;
+					goto atan2_done;
+				}
+				count++;
+			}
+		}
+	atan2_done:
+		printf( "atan2 grid: %lld pairs checked\n", count );
+		CHECK( count == 4097 * 4097 );
+	}
+
+	// atan2 axes and the (0,0) and equal-magnitude edges that drive a == 2^32.
+	{
+		CHECK( fixAtan2( 0, 0 ) == refAtan2( 0, 0 ) );
+		CHECK( fixAtan2( FIX_ONE, FIX_ONE ) == refAtan2( FIX_ONE, FIX_ONE ) );
+		CHECK( fixAtan2( -FIX_ONE, -FIX_ONE ) == refAtan2( -FIX_ONE, -FIX_ONE ) );
+		CHECK( fixAtan2( FIX_ONE, -FIX_ONE ) == refAtan2( FIX_ONE, -FIX_ONE ) );
+		CHECK( fixAtan2( -FIX_ONE, FIX_ONE ) == refAtan2( -FIX_ONE, FIX_ONE ) );
+		CHECK( fixAtan2( FIX_ONE, 0 ) == refAtan2( FIX_ONE, 0 ) );
+		CHECK( fixAtan2( 0, FIX_ONE ) == refAtan2( 0, FIX_ONE ) );
+		CHECK( fixAtan2( 0, -FIX_ONE ) == refAtan2( 0, -FIX_ONE ) );
+		CHECK( fixAtan2( -FIX_ONE, 0 ) == refAtan2( -FIX_ONE, 0 ) );
+	}
+
+	if ( fails == 0 )
+	{
+		printf( "TrigEvaluationExhaustiveTest: PASS\n" );
+	}
+	return fails == 0 ? 0 : 1;
+}
