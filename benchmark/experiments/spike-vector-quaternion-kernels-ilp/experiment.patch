+// ---------------------------------------------------------------------------
+// VecQuatKernelEquivalenceTest: the ILP-restructured kernels must stay bit-identical
+// to the pre-restructuring implementations. The reference bodies below are the OLD
+// spellings copied verbatim (single-expression reductions, per-statement cross), so a
+// scheduling-only change that moved a single output bit fails here. No clock: work is
+// counted with a counter.
+// ---------------------------------------------------------------------------
+
+static fixVec3 refCross( fixVec3 a, fixVec3 b )
+{
+	fixVec3 c;
+	c.x = fixMul( a.y, b.z ) - fixMul( a.z, b.y );
+	c.y = fixMul( a.z, b.x ) - fixMul( a.x, b.z );
+	c.z = fixMul( a.x, b.y ) - fixMul( a.y, b.x );
+	return c;
+}
+
+static fixVec3 refMulMV( fixMatrix3 m, fixVec3 a )
+{
+	fixVec3 b = {
+		fixMul( m.cx.x, a.x ) + fixMul( m.cy.x, a.y ) + fixMul( m.cz.x, a.z ),
+		fixMul( m.cx.y, a.x ) + fixMul( m.cy.y, a.y ) + fixMul( m.cz.y, a.z ),
+		fixMul( m.cx.z, a.x ) + fixMul( m.cy.z, a.y ) + fixMul( m.cz.z, a.z ),
+	};
+	return b;
+}
+
+static fixQuat refMulQuat( fixQuat q1, fixQuat q2 )
+{
+	// The pre-restructuring spelling, written through the seam vocabulary so it
+	// compiles on both the native and emulated 128-bit arms (bit-identical to the
+	// old native single-expression form).
+	fixQuat q = {
+		{
+			fixFromDotRaw( fixInt128Add(
+				fixInt128Add( fixInt128Sub( fixInt128MulI64( q1.v.y, q2.v.z ), fixInt128MulI64( q1.v.z, q2.v.y ) ),
+							  fixInt128MulI64( q1.s, q2.v.x ) ),
+				fixInt128MulI64( q2.s, q1.v.x ) ) ),
+			fixFromDotRaw( fixInt128Add(
+				fixInt128Add( fixInt128Sub( fixInt128MulI64( q1.v.z, q2.v.x ), fixInt128MulI64( q1.v.x, q2.v.z ) ),
+							  fixInt128MulI64( q1.s, q2.v.y ) ),
+				fixInt128MulI64( q2.s, q1.v.y ) ) ),
+			fixFromDotRaw( fixInt128Add(
+				fixInt128Add( fixInt128Sub( fixInt128MulI64( q1.v.x, q2.v.y ), fixInt128MulI64( q1.v.y, q2.v.x ) ),
+							  fixInt128MulI64( q1.s, q2.v.z ) ),
+				fixInt128MulI64( q2.s, q1.v.z ) ) ),
+		},
+		fixFromDotRaw( fixInt128Sub( fixInt128MulI64( q1.s, q2.s ), fixDotRaw( q1.v, q2.v ) ) ),
+	};
+	return q;
+}
+
+static fixVec3 refRotateVector( fixQuat q, fixVec3 v )
+{
+	fixVec3 t1 = refCross( q.v, v );
+	fixVec3 t2 = fixMulAdd( t1, q.s, v );
+	fixVec3 t3 = refCross( q.v, t2 );
+	return fixMulAdd( v, FIX( 2.0f ), t3 );
+}
+
+static fixVec3 refInvRotateVector( fixQuat q, fixVec3 v )
+{
+	fixVec3 t1 = refCross( q.v, v );
+	fixVec3 t2 = fixMulSub( t1, q.s, v );
+	fixVec3 t3 = refCross( q.v, t2 );
+	return fixMulAdd( v, FIX( 2.0f ), t3 );
+}
+
+static fixVec3 refTransformPoint( fixTransform t, fixVec3 v )
+{
+	fixVec3 rv = refRotateVector( t.q, v );
+	return fixVecAdd( rv, t.p );
+}
+
+static uint64_t eqSeed;
+static uint64_t eqNext(void)
+{
+	eqSeed ^= eqSeed << 13; eqSeed ^= eqSeed >> 7; eqSeed ^= eqSeed << 17;
+	return eqSeed;
+}
+static fixed_t eqFixed(void)
+{
+	uint64_t mag = eqNext() & ((UINT64_C(1) << 46) - 1);
+	if (mag == 0) mag = 1;
+	fixed_t v = (fixed_t)mag;
+	return (eqNext() & 1) ? -v : v;
+}
+static fixVec3 eqVec3(void) { return (fixVec3){ eqFixed(), eqFixed(), eqFixed() }; }
+static fixQuat eqQuat(void) { return (fixQuat){ eqVec3(), eqFixed() }; }
+static fixMatrix3 eqMat3(void) { return (fixMatrix3){ eqVec3(), eqVec3(), eqVec3() }; }
+static fixTransform eqTransform(void) { return (fixTransform){ eqVec3(), eqQuat() }; }
+
+static bool eqVec3Equal(fixVec3 a, fixVec3 b) { return a.x == b.x && a.y == b.y && a.z == b.z; }
+static bool eqQuatEqual(fixQuat a, fixQuat b) { return eqVec3Equal(a.v, b.v) && a.s == b.s; }
+
+static void vecQuatKernelEquivalence(void)
+{
+	// Structured edge grid per component: 0, +-1, +-2^k, +-(2^k-1), INT64_MIN/MAX, saturation.
+	fixed_t edge[300];
+	int ne = 0;
+	edge[ne++] = 0; edge[ne++] = 1; edge[ne++] = -1;
+	edge[ne++] = INT64_MIN; edge[ne++] = INT64_MAX; edge[ne++] = FIX_MIN; edge[ne++] = FIX_MAX;
+	for (int k = 0; k < 62; ++k)
+	{
+		fixed_t p = (fixed_t)1 << k;
+		edge[ne++] = p; edge[ne++] = -p;
+		edge[ne++] = p - 1; edge[ne++] = -(p - 1);
+	}
+
+	// Edge grid: cross every edge value against itself for the binary kernels.
+	for (int i = 0; i < ne; ++i)
+		for (int j = 0; j < ne; ++j)
+		{
+			fixVec3 a = { edge[i], edge[j], edge[(i + j) % ne] };
+			fixVec3 b = { edge[j], edge[(i * 7 + j) % ne], edge[i] };
+			CHECK(eqVec3Equal(fixCross(a, b), refCross(a, b)));
+			fixMatrix3 m = { a, b, { edge[(i + 1) % ne], edge[(j + 1) % ne], edge[(i + j + 1) % ne] } };
+			CHECK(eqVec3Equal(fixMulMV(m, a), refMulMV(m, a)));
+			fixQuat q1 = { a, edge[i] };
+			fixQuat q2 = { b, edge[j] };
+			CHECK(eqQuatEqual(fixMulQuat(q1, q2), refMulQuat(q1, q2)));
+			CHECK(eqVec3Equal(fixRotateVector(q1, a), refRotateVector(q1, a)));
+			CHECK(eqVec3Equal(fixInvRotateVector(q1, a), refInvRotateVector(q1, a)));
+			fixTransform t = { a, q1 };
+			CHECK(eqVec3Equal(fixTransformPoint(t, b), refTransformPoint(t, b)));
+		}
+
+	// Seeded random inputs across magnitudes 2^-16 .. 2^30, plus aliasing (out == in).
+	// 10M per type keeps the emulated arm's CI time reasonable; the edge grid above and
+	// the aliasing cases below add the structured coverage.
+	eqSeed = UINT64_C(0x9e3779b97f4a7c15);
+	const int N = 10000000;
+	for (int i = 0; i < N; ++i)
+	{
+		fixVec3 a = eqVec3();
+		fixVec3 b = eqVec3();
+		fixQuat q1 = eqQuat();
+		fixQuat q2 = eqQuat();
+		fixMatrix3 m = eqMat3();
+		fixTransform t = eqTransform();
+
+		CHECK(eqVec3Equal(fixCross(a, b), refCross(a, b)));
+		CHECK(eqVec3Equal(fixMulMV(m, a), refMulMV(m, a)));
+		CHECK(eqQuatEqual(fixMulQuat(q1, q2), refMulQuat(q1, q2)));
+		CHECK(eqVec3Equal(fixRotateVector(q1, a), refRotateVector(q1, a)));
+		CHECK(eqVec3Equal(fixInvRotateVector(q1, a), refInvRotateVector(q1, a)));
+		CHECK(eqVec3Equal(fixTransformPoint(t, b), refTransformPoint(t, b)));
+
+		// Aliasing: the result overwrites an input. The kernels take values, so this
+		// exercises the same code path; kept for the contract's completeness.
+		fixVec3 c = fixCross(a, b);
+		CHECK(eqVec3Equal(c, refCross(a, b)));
+	}
+}
+
 int main(int argc, char** argv)
 {
 	struct { const char* name; void (*run)(void); } tests[] = {
 		{ "normalization", normalization }, { "angles", angles }, { "validators", validators },
 		{ "bounds", bounds }, { "transformed_bounds", transformedBounds },
 		{ "quantize", quantize }, { "time", timeConversion }, { "square_roots", squareRoots },
-		{ "square_roots_64", squareRoots64 }
+		{ "square_roots_64", squareRoots64 }, { "vec_quat_kernel_equivalence", vecQuatKernelEquivalence }
 	};
 	for (size_t i = 0; i < sizeof(tests)/sizeof(tests[0]); ++i)
 	{
