# Gappa proof for the log1p polynomial evaluation in src/exact/log_kernel.h.
# All values are real-valued scaled integers: c2..c10 are the stored signed
# Q.127 coefficient words divided by 2^127, and x = u128 / 2^128. The Horner
# recurrence, square, and final product use exactly the source formats.
#
# r9..r2, rq, rv are the downward-rounding residues (each in [-1 ulp, 0]).
# The backward error recurrence is algebraically the difference between the
# rounded Horner chain and the exact quantized polynomial; it avoids subtracting
# two nearly equal interval enclosures. The Sollya supnorm h is a hypothesis.

{
  x in [0, 0.0078125]

  /\ c2 = -0.499999999999999999999987510325942327159074213082474166742803999653836767030864169747243763719524167754570953547954559326171875
  /\ c3 = 0.3333333333333333332911061271819867303596105270885888060375317464377755265691885823930128152081664438810548745095729827880859375
  /\ c4 = -0.249999999999999944385684977268856847992206648427281202860004946845363463259488459567402018901560722952126525342464447021484375
  /\ c5 = 0.199999999999961381590621044023942020939813005401513489511398787677306286049379435557950268620430733790271915495395660400390625
  /\ c6 = -0.1666666666507585407602717836708001684933888080057972135605077549132962280572660789521900748244576107026659883558750152587890625
  /\ c7 = 0.142857138765486720947694441554866163448110739088123478923048795492130955483393246253399910816739293295540846884250640869140625
  /\ c8 = -0.1249993355012364509113927086399355784073517701098171182970059238834380449276426173024247268106279307176009751856327056884765625
  /\ c9 = 0.1110448073020671993077208797892456763298418020190512196020338057316816137991459666916650717016779026380390860140323638916015625
  /\ c10 = -0.0962793672760566769673078668935352666053476489572616457968394385326806012253807797265404977427039057147339917719364166259765625

  /\ p10 = c10
  /\ p9 = c9 - p10 * x
  /\ p8 = c8 - p9 * x
  /\ p7 = c7 - p8 * x
  /\ p6 = c6 - p7 * x
  /\ p5 = c5 - p6 * x
  /\ p4 = c4 - p5 * x
  /\ p3 = c3 - p4 * x
  /\ p2 = c2 - p3 * x
  /\ p = x - 2 * x * x * p2

  /\ w10 = c10
  /\ w9 = c9 - fixed<127, dn>(w10 * x)
  /\ w8 = c8 - fixed<127, dn>(w9 * x)
  /\ w7 = c7 - fixed<127, dn>(w8 * x)
  /\ w6 = c6 - fixed<127, dn>(w7 * x)
  /\ w5 = c5 - fixed<127, dn>(w6 * x)
  /\ w4 = c4 - fixed<127, dn>(w5 * x)
  /\ w3 = c3 - fixed<127, dn>(w4 * x)
  /\ w2 = c2 - fixed<127, dn>(w3 * x)
  /\ qq = fixed<128, dn>(x * x)
  /\ vv = fixed<127, dn>(qq * w2)
  /\ computed = x - 2 * vv

  /\ r9 in [-5.877471754111438e-39, 0]
  /\ r8 in [-5.877471754111438e-39, 0]
  /\ r7 in [-5.877471754111438e-39, 0]
  /\ r6 in [-5.877471754111438e-39, 0]
  /\ r5 in [-5.877471754111438e-39, 0]
  /\ r4 in [-5.877471754111438e-39, 0]
  /\ r3 in [-5.877471754111438e-39, 0]
  /\ r2 in [-5.877471754111438e-39, 0]
  /\ rq in [-2.938735877055719e-39, 0]
  /\ rv in [-5.877471754111438e-39, 0]
  /\ r9 = fixed<127, dn>(w10 * x) - w10 * x
  /\ r8 = fixed<127, dn>(w9 * x) - w9 * x
  /\ r7 = fixed<127, dn>(w8 * x) - w8 * x
  /\ r6 = fixed<127, dn>(w7 * x) - w7 * x
  /\ r5 = fixed<127, dn>(w6 * x) - w6 * x
  /\ r4 = fixed<127, dn>(w5 * x) - w5 * x
  /\ r3 = fixed<127, dn>(w4 * x) - w4 * x
  /\ r2 = fixed<127, dn>(w3 * x) - w3 * x
  /\ rq = qq - x * x
  /\ rv = vv - qq * w2

  /\ d10 = 0
  /\ d9 = -d10 * x - r9
  /\ d8 = -d9 * x - r8
  /\ d7 = -d8 * x - r7
  /\ d6 = -d7 * x - r6
  /\ d5 = -d6 * x - r5
  /\ d4 = -d5 * x - r4
  /\ d3 = -d4 * x - r3
  /\ d2 = -d3 * x - r2

  /\ eh = 2 * (|rq| * |w2| + x * x * |d2| + |rv|)
  /\ h in [0, 3.83734e-31]
  /\ total = eh + h
  /\ ln_raw = total * 65536
  /\ log2_raw = total * 1.4427 * 65536 + 4.930380657631324e-32
  /\ log10_raw = (total * 0.4343 + 33 * 1.469367938527860e-39 + 7.523163845262641e-37) * 65536

  ->
  |w2| <= 0.501 /\
  |d2| <= 6e-39 /\
  eh <= 1e-38 /\
  total <= 3.838e-31 /\
  ln_raw <= 2.515e-26 /\
  log2_raw <= 3.63e-26 /\
  log10_raw <= 1.10e-26
}
