// The tan kernel of docs/design/transcendentals.md (the tan section).
// Run: sollya sollya/tan_kernel.sollya > sollya/tan_kernel.out
//
// After the Payne-Hanek reduction, |r| <= pi/4; j = round(r * 128) in 0..101 and
// s = r - j/128, |s| <= 2^-8. tan(s) = s + sum C_k s^k, k = 3, 5, ..., 13, each C_k a multiple of
// 2^-127, the s coefficient fixed at exactly 1. This kernel feeds a reciprocal near the poles
// (cot r = 1/tan r with j = 0), so its error has to be small relative to tan(s) right down to
// s = 2^-65, not only in absolute terms: the fit is minimax in the RELATIVE error, and the
// certificate is printed twice, relative (used near the poles) and absolute (used on the
// table path). Also prints the tan(j/128) table, pi/2 and 240 bits of 2/pi.
prec = 400!;
display = decimal!;
verbosity = 0!;
procedure ni(e) { return nearestint(round(e, 350, RN)); };

n = 13;
h = 2^-8 + 2^-100;  // the slack covers the rounding of s; 2^-120 makes this Remez fail to converge at prec 400
I = [-h; h];
ml = [|1|]; for i from 3 to n by 2 do ml = ml :. i;
fm = [|0|]; for i from 3 to n by 2 do fm = fm :. 127;
p = fpminimax(tan(x), ml, fm, I, fixed, relative);
sr = supnorm(p, tan(x), I, relative, 2^-80);
sa = supnorm(p, tan(x), I, absolute, 2^-80);

print("tan kernel: tan(s) = s + sum_{k=3,5,..,13} C_k * 2^-127 * s^k on s in [-(2^-8 + 2^-100), 2^-8 + 2^-100]");
print("degree =", n, " coefficient format: unsigned, 127 fraction bits; C_1 =", coeff(p, 1));
for i from 3 to n by 2 do print("C_" @ i @ " =", coeff(p, i) * 2^127);
print("supnorm |p/tan - 1|, relative:", sr);
print("log2 of the certified relative bound:", round(log2(sup(sr)), 24, RU));
print("supnorm |p - tan|, absolute:", sa);
print("log2 of the certified absolute bound:", round(log2(sup(sa)), 24, RU));

print("PIO2_127 = round(pi/2 * 2^127) =", ni(pi/2 * 2^127));
w = floor(round(2^240 * 2 / pi, 350, RN));
w0 = floor(w / 2^192); w1 = floor(w / 2^128) - w0 * 2^64; w2 = floor(w / 2^64) - floor(w / 2^128) * 2^64; w3 = w - floor(w / 2^64) * 2^64;
print("TWO_OVER_PI_240 = floor(2^240 * 2/pi) as four 64-bit words, high first:");
print("W0 =", w0); print("W1 =", w1); print("W2 =", w2); print("W3 =", w3);
print("W0:W1 equal fixed-sincos-exact FIX_TWO_OVER_PI_HI:LO (0x0000A2F9836E4E44, 0x1529FC2757D1F534):",
      (w0 == 179192535600708) && (w1 == 1525027194748925236));
print("table TAN_j = round(tan(j/128) * 2^127) as hi:lo, j = 0..101");
for j from 0 to 101 do {
  v = ni(tan(j/128) * 2^127);
  hh = floor(v / 2^64);
  print("T", j, hh, v - hh * 2^64);
};
